---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { buildPageMeta, type PageMetaInput } from '../lib/seo/meta';
import { buildOrganizationSchema, buildWebSiteSchema } from '../lib/seo/schema';
import ConsentBanner from '../components/ConsentBanner.astro';
import Icon from '../components/Icon.astro';
import categories from '../data/categories.json';

interface Props extends PageMetaInput {
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  pathname,
  noindex = false,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  schemas = [],
} = Astro.props;

const meta = buildPageMeta({
  title,
  description,
  pathname,
  noindex,
  ogType,
  ogImage,
  publishedTime,
  modifiedTime,
});

const allSchemas = [
  ...(pathname === '/' ? [buildWebSiteSchema(), buildOrganizationSchema()] : []),
  ...schemas,
];

const navLinks = [
  { label: 'Calculators', href: '/calculators/', active: pathname.startsWith('/calculators') },
  { label: 'Cost Guides', href: '/cost/', active: pathname.startsWith('/cost') },
  { label: 'How-To Guides', href: '/guides/', active: pathname.startsWith('/guides') },
  { label: 'Methodology', href: '/methodology/', active: pathname.startsWith('/methodology') },
];
---

<!doctype html>
<html lang={siteConfig.locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={meta.robots} />
    <link rel="canonical" href={meta.canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={meta.ogType} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonicalUrl} />
    <meta property="og:image" content={meta.ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.ogImage} />

    <!-- Theme initialization (zero FOUC) -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('buildmath_theme');
          if (
            theme === 'dark' ||
            (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)
          ) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    {allSchemas.map((schemaObj) => (
      <script type="application/ld+json" set:html={JSON.stringify(schemaObj)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg focus:bg-lime-500 focus:text-graphite-900 focus:font-semibold"
    >
      Skip to main content
    </a>

    <!-- Precision Header -->
    <header class="sticky top-0 z-40 border-b border-hairline bg-canvas/95 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <div class="flex items-center gap-7 min-w-0">
          <!-- Distinctive Architectural Framing-Square Mark + Geist Wordmark -->
          <a href="/" class="inline-flex items-center gap-2.5 group shrink-0">
            <svg
              viewBox="0 0 36 36"
              width="34"
              height="34"
              aria-hidden="true"
              class="shrink-0 transition-transform duration-150 group-hover:scale-[1.03]"
            >
              <rect width="36" height="36" rx="8" fill="#171B20" />
              <rect x="2" y="2" width="32" height="32" rx="6" fill="none" stroke="#282E37" stroke-width="1" />
              <path d="M9 8v19h18v-4.5H13.5V8H9z" fill="#F8F8F5" />
              <line x1="9" y1="13" x2="11.5" y2="13" stroke="#171B20" stroke-width="1.2" />
              <line x1="9" y1="17.5" x2="11.5" y2="17.5" stroke="#171B20" stroke-width="1.2" />
              <line x1="14.5" y1="10.5" x2="25.5" y2="21.5" stroke="#6FA3D2" stroke-width="2" stroke-linecap="square" />
              <rect x="22.5" y="8" width="5.5" height="5.5" rx="1.2" fill="#C6F36A" />
            </svg>
            <div class="flex items-baseline gap-1.5">
              <span class="font-display text-lg sm:text-[19px] font-bold tracking-[-0.03em] text-ink">
                {siteConfig.name}
              </span>
              <span class="hidden sm:inline font-mono text-[10px] font-semibold uppercase tracking-wider text-ink-muted">
                US
              </span>
            </div>
          </a>

          <!-- Primary Navigation -->
          <nav aria-label="Main navigation" class="hidden lg:flex items-center gap-1 text-sm font-medium">
            {navLinks.map((link) => (
              <a
                href={link.href}
                aria-current={link.active ? 'page' : undefined}
                class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md transition-colors whitespace-nowrap ${
                  link.active
                    ? 'bg-surface text-ink border border-hairline font-semibold'
                    : 'text-ink-muted hover:text-ink hover:bg-surface-subtle/70'
                }`}
              >
                {link.active && (
                  <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-lime-500"></span>
                )}
                <span>{link.label}</span>
              </a>
            ))}
          </nav>
        </div>

        <!-- Right Controls: Global Search + My Project Workspace + Theme + Explore CTA -->
        <div class="flex items-center gap-2 shrink-0">
          <button
            id="global-search-open-btn"
            type="button"
            aria-label="Open global calculator search"
            class="inline-flex items-center gap-2 h-9 px-2.5 sm:px-3 rounded-lg border border-hairline bg-surface text-xs text-ink-muted hover:text-ink hover:border-hairline-strong transition-colors"
          >
            <Icon name="search" size={14} class="text-ink-muted" />
            <span class="hidden lg:inline font-medium">Search</span>
            <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono bg-surface-subtle border border-hairline rounded">
              Ctrl K
            </kbd>
          </button>

          <a
            href="/my-project/"
            aria-current={pathname.startsWith('/my-project') ? 'page' : undefined}
            class={`inline-flex items-center gap-2 px-2.5 sm:px-3 py-1.5 rounded-lg text-xs font-semibold border transition-colors h-9 ${
              pathname.startsWith('/my-project')
                ? 'border-blueprint bg-blueprint-soft text-ink'
                : 'border-hairline bg-surface hover:border-hairline-strong text-ink'
            }`}
          >
            <Icon name="clipboard-list" size={15} class="text-blueprint" />
            <span class="hidden sm:inline">My Project</span>
            <span
              id="project-count-badge"
              class="inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 text-[10px] font-mono font-bold rounded bg-surface-subtle text-ink border border-hairline tabular-nums transition-colors"
            >
              0
            </span>
          </a>

          <a
            href="/calculators/"
            class="hidden xl:inline-flex items-center gap-1.5 h-9 px-3.5 rounded-lg text-xs font-semibold bg-lime-500 hover:bg-lime-600 text-graphite-900 border border-[#17191C]/10 transition-colors"
          >
            <span>Explore Calculators</span>
            <Icon name="arrow-right" size={13} />
          </a>

          <button
            id="theme-toggle-btn"
            type="button"
            aria-label="Toggle color theme"
            class="inline-flex items-center justify-center h-9 w-9 rounded-lg border border-hairline bg-surface text-ink-muted hover:text-ink hover:border-hairline-strong transition-colors"
          >
            <span aria-hidden="true" class="dark:hidden flex items-center justify-center">
              <Icon name="moon" size={16} />
            </span>
            <span aria-hidden="true" class="hidden dark:flex items-center justify-center text-lime-500">
              <Icon name="sun" size={16} />
            </span>
          </button>

          <button
            id="mobile-menu-btn"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
            aria-label="Open navigation menu"
            class="lg:hidden inline-flex items-center justify-center h-9 w-9 rounded-lg border border-hairline bg-surface text-ink hover:bg-surface-subtle transition-colors"
          >
            <span id="menu-icon-open" class="flex items-center justify-center">
              <Icon name="menu" size={17} />
            </span>
            <span id="menu-icon-close" class="hidden items-center justify-center">
              <Icon name="x" size={17} />
            </span>
          </button>
        </div>
      </div>

      <!-- Mobile & Tablet Quick Sub-Nav + Collapsible Drawer -->
      <nav
        aria-label="Mobile quick navigation"
        class="lg:hidden border-t border-hairline bg-surface/95 px-4 sm:px-6 py-1.5 flex items-center justify-between text-xs font-medium text-ink-muted overflow-x-auto gap-3"
      >
        <a href="/calculators/" class={`py-1.5 whitespace-nowrap ${pathname.startsWith('/calculators') ? 'text-ink font-semibold' : 'hover:text-ink'}`}>
          Calculators
        </a>
        <a href="/cost/" class={`py-1.5 whitespace-nowrap ${pathname.startsWith('/cost') ? 'text-ink font-semibold' : 'hover:text-ink'}`}>
          Cost Guides
        </a>
        <a href="/guides/" class={`py-1.5 whitespace-nowrap ${pathname.startsWith('/guides') ? 'text-ink font-semibold' : 'hover:text-ink'}`}>
          How-To Guides
        </a>
        <a href="/my-project/" class={`py-1.5 whitespace-nowrap ${pathname.startsWith('/my-project') ? 'text-ink font-semibold' : 'hover:text-ink'}`}>
          Workspace
        </a>
      </nav>

      <div
        id="mobile-nav-drawer"
        class="hidden lg:hidden border-t border-hairline bg-surface px-4 py-4 space-y-2 shadow-lg"
      >
        <div class="grid grid-cols-2 gap-2">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class={`flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium border ${
                link.active
                  ? 'border-graphite-900 bg-graphite-900 text-[#F8F8F5] dark:border-lime-500 dark:bg-surface-subtle dark:text-ink'
                  : 'border-hairline bg-canvas text-ink'
              }`}
            >
              <span>{link.label}</span>
              <Icon name="chevron-right" size={15} class="opacity-60" />
            </a>
          ))}
          <a
            href="/about/"
            class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium border border-hairline bg-canvas text-ink"
          >
            <span>About</span>
            <Icon name="chevron-right" size={15} class="opacity-60" />
          </a>
          <a
            href="/contact/"
            class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium border border-hairline bg-canvas text-ink"
          >
            <span>Contact</span>
            <Icon name="chevron-right" size={15} class="opacity-60" />
          </a>
        </div>
        <a href="/calculators/" class="bm-btn-lime w-full text-xs font-bold mt-2">
          <span>Explore All 32 Calculators</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
      <slot />
    </main>

    <!-- Architectural Dark Graphite Footer -->
    <footer class="mt-20 bg-graphite-900 text-[#D2D6DC] border-t border-graphite-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
        <!-- Footer Top Utility Band -->
        <div class="pb-10 mb-10 border-b border-graphite-700 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
          <div class="max-w-lg space-y-2.5">
            <a href="/" class="inline-flex items-center gap-2.5 font-display font-bold text-lg text-[#F8F8F5]">
              <svg viewBox="0 0 36 36" width="28" height="28" aria-hidden="true">
                <rect width="36" height="36" rx="7" fill="#1F252C" stroke="#2E3642" stroke-width="1" />
                <path d="M9 8v19h18v-4.5H13.5V8H9z" fill="#F8F8F5" />
                <line x1="14.5" y1="10.5" x2="25.5" y2="21.5" stroke="#6FA3D2" stroke-width="2" />
                <rect x="22.5" y="8" width="5.5" height="5.5" rx="1.2" fill="#C6F36A" />
              </svg>
              <span>{siteConfig.name}</span>
              <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-0.5 rounded bg-graphite-800 border border-graphite-700 text-[#9BA1AA]">
                US Building Specs
              </span>
            </a>
            <p class="text-xs sm:text-sm text-[#9BA1AA] leading-relaxed">
              Deterministic residential construction calculators and bottom-up cost modeling compiled by {siteConfig.author.name}. Zero sign-up required; calculations run privately in your browser.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2.5 shrink-0">
            <a
              href="/calculators/"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-bold bg-lime-500 hover:bg-lime-600 text-graphite-900 transition-colors"
            >
              <span>Explore All 32 Calculators</span>
              <Icon name="arrow-right" size={14} />
            </a>
            <a
              href="/my-project/"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-medium bg-graphite-800 hover:bg-graphite-700 text-[#F8F8F5] border border-graphite-700 transition-colors"
            >
              <Icon name="clipboard-list" size={14} class="text-[#6FA3D2]" />
              <span>Project Workspace</span>
            </a>
            <a
              href="/methodology/"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-medium bg-graphite-950 hover:bg-graphite-800 text-[#D2D6DC] border border-graphite-700 transition-colors"
            >
              <span>Methodology</span>
            </a>
          </div>
        </div>

        <!-- Structured 4-Column Navigation Matrix -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
          <div>
            <h2 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-[#F8F8F5] mb-3.5">
              8 Trade Categories
            </h2>
            <ul class="space-y-2 text-xs sm:text-sm text-[#9BA1AA]">
              {categories.map((cat) => (
                <li>
                  <a href={`/calculators/${cat.slug}/`} class="hover:text-lime-500 transition-colors">
                    {cat.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-[#F8F8F5] mb-3.5">
              Flagship Tools
            </h2>
            <ul class="space-y-2 text-xs sm:text-sm text-[#9BA1AA]">
              <li><a href="/calculators/concrete-slab-calculator/" class="hover:text-lime-500 transition-colors">Concrete Slab Calculator</a></li>
              <li><a href="/calculators/paint-calculator/" class="hover:text-lime-500 transition-colors">Interior Paint Calculator</a></li>
              <li><a href="/calculators/drywall-calculator/" class="hover:text-lime-500 transition-colors">Drywall Sheet &amp; Mud Calc</a></li>
              <li><a href="/calculators/roofing-calculator/" class="hover:text-lime-500 transition-colors">Roofing Shingle Calculator</a></li>
              <li><a href="/calculators/mulch-calculator/" class="hover:text-lime-500 transition-colors">Mulch &amp; Bed Calculator</a></li>
              <li><a href="/calculators/stair-calculator/" class="hover:text-lime-500 transition-colors">Stair Stringer Calculator</a></li>
              <li><a href="/calculators/square-footage-calculator/" class="hover:text-lime-500 transition-colors">Square Footage Calculator</a></li>
            </ul>
          </div>

          <div>
            <h2 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-[#F8F8F5] mb-3.5">
              Cost Guides &amp; Field Docs
            </h2>
            <ul class="space-y-2 text-xs sm:text-sm text-[#9BA1AA]">
              <li><a href="/cost/" class="hover:text-lime-500 transition-colors">All 25 Project Cost Guides</a></li>
              <li><a href="/cost/roof-replacement/" class="hover:text-lime-500 transition-colors">Roof Replacement Cost (Verified)</a></li>
              <li><a href="/cost/interior-painting/" class="hover:text-lime-500 transition-colors">Interior Painting Cost (Verified)</a></li>
              <li><a href="/cost/concrete-patio/" class="hover:text-lime-500 transition-colors">Concrete Patio Cost (Verified)</a></li>
              <li><a href="/guides/" class="hover:text-lime-500 transition-colors">Measurement Field Guides</a></li>
              <li><a href="/my-project/" class="hover:text-lime-500 transition-colors">My Project Workspace</a></li>
            </ul>
          </div>

          <div>
            <h2 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-[#F8F8F5] mb-3.5">
              Governance &amp; Legal
            </h2>
            <ul class="space-y-2 text-xs sm:text-sm text-[#9BA1AA]">
              <li><a href="/about/" class="hover:text-lime-500 transition-colors">About {siteConfig.name}</a></li>
              <li><a href="/methodology/" class="hover:text-lime-500 transition-colors">Formula &amp; Cost Methodology</a></li>
              <li><a href="/contact/" class="hover:text-lime-500 transition-colors">Contact &amp; Feedback</a></li>
              <li><a href="/affiliate-disclosure/" class="hover:text-lime-500 transition-colors">Affiliate Disclosure</a></li>
              <li><a href="/disclaimer/" class="hover:text-lime-500 transition-colors">Construction Disclaimer</a></li>
              <li><a href="/privacy-policy/" class="hover:text-lime-500 transition-colors">Privacy Policy</a></li>
              <li><a href="/cookie-policy/" class="hover:text-lime-500 transition-colors">Cookie Policy</a></li>
              <li><a href="/terms/" class="hover:text-lime-500 transition-colors">Terms of Use</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-12 pt-6 border-t border-graphite-700 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-[#8E949D]">
          <p>
            © {new Date().getFullYear()} {siteConfig.legalName}. All estimates are planning references; verify local IRC/IBC building codes and product TDS before ordering or building.
          </p>
          <p class="font-mono flex items-center gap-3 shrink-0">
            <a href="/sitemap-index.xml" class="hover:text-[#F8F8F5] transition-colors">sitemap-index.xml</a>
            <span>//</span>
            <a href="/llms.txt" class="hover:text-[#F8F8F5] transition-colors">llms.txt</a>
          </p>
        </div>
      </div>
    </footer>

    <!-- Functional Global Search Command Modal (Lazy loads /search-index.json) -->
    <div
      id="global-search-modal"
      role="dialog"
      aria-modal="true"
      aria-label="Search BuildMath tools and cost guides"
      class="hidden fixed inset-0 z-50 bg-[#0D1013]/70 backdrop-blur-sm px-4 pt-16 sm:pt-24 flex items-start justify-center"
    >
      <div class="w-full max-w-2xl rounded-xl bg-surface border border-hairline-strong shadow-2xl overflow-hidden">
        <div class="flex items-center gap-3 px-4 py-3 border-b border-hairline">
          <Icon name="search" size={18} class="text-blueprint" />
          <input
            id="global-search-input"
            type="search"
            autocomplete="off"
            placeholder="Search all 32 calculators and 25 cost guides..."
            class="flex-1 bg-transparent text-ink text-sm sm:text-base placeholder:text-ink-muted focus:outline-none"
          />
          <button
            id="global-search-close-btn"
            type="button"
            aria-label="Close global search"
            class="px-2 py-1 rounded text-[11px] font-mono bg-surface-subtle border border-hairline text-ink-muted hover:text-ink"
          >
            ESC
          </button>
        </div>

        <div id="global-search-results" class="max-h-[60vh] overflow-y-auto divide-y divide-hairline">
          <div class="p-6 text-center text-xs text-ink-muted font-mono">
            Loading 57 tools &amp; guides index...
          </div>
        </div>

        <div class="px-4 py-2.5 border-t border-hairline bg-surface-subtle/50 flex items-center justify-between text-[11px] font-mono text-ink-muted">
          <span>↑↓ Navigate · Enter to open</span>
          <a href="/calculators/" class="text-blueprint font-semibold hover:underline">Open Full Directory →</a>
        </div>
      </div>
    </div>

    <ConsentBanner />

    <script is:inline>
      (function () {
        function updateProjectBadge() {
          try {
            var badge = document.getElementById('project-count-badge');
            if (!badge) return;
            var raw = localStorage.getItem('buildmath_project_list');
            var list = raw ? JSON.parse(raw) : [];
            var count = Array.isArray(list) ? list.length : 0;
            badge.textContent = String(count);
            if (count > 0) {
              badge.classList.add('!bg-[#C6F36A]', '!text-[#17191C]', '!border-transparent');
            } else {
              badge.classList.remove('!bg-[#C6F36A]', '!text-[#17191C]', '!border-transparent');
            }
          } catch (e) {}
        }

        updateProjectBadge();
        window.addEventListener('buildmath:project-updated', updateProjectBadge);
        window.addEventListener('storage', updateProjectBadge);

        var toggleBtn = document.getElementById('theme-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', function () {
            var isDark = document.documentElement.classList.toggle('dark');
            try {
              localStorage.setItem('buildmath_theme', isDark ? 'dark' : 'light');
            } catch (e) {}
          });
        }

        var menuBtn = document.getElementById('mobile-menu-btn');
        var drawer = document.getElementById('mobile-nav-drawer');
        var iconOpen = document.getElementById('menu-icon-open');
        var iconClose = document.getElementById('menu-icon-close');
        if (menuBtn && drawer) {
          menuBtn.addEventListener('click', function () {
            var isHidden = drawer.classList.toggle('hidden');
            menuBtn.setAttribute('aria-expanded', String(!isHidden));
            if (iconOpen && iconClose) {
              iconOpen.classList.toggle('hidden', !isHidden);
              iconOpen.classList.toggle('flex', isHidden);
              iconClose.classList.toggle('hidden', isHidden);
              iconClose.classList.toggle('flex', !isHidden);
            }
          });
        }

        // Global Command Search Modal
        var modal = document.getElementById('global-search-modal');
        var openBtn = document.getElementById('global-search-open-btn');
        var closeBtn = document.getElementById('global-search-close-btn');
        var searchInput = document.getElementById('global-search-input');
        var resultsEl = document.getElementById('global-search-results');
        var cachedIndex = null;
        var activeIdx = -1;

        function escapeHtml(str) {
          return String(str || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
        }

        function renderGlobalResults(query) {
          if (!cachedIndex || !resultsEl) return;
          var q = (query || '').trim().toLowerCase();
          var matches = q
            ? cachedIndex.filter(function (item) {
                var hay = (item.title + ' ' + item.categoryName + ' ' + item.description + ' ' + (item.inputsLabel || '') + ' ' + (item.outputsLabel || '')).toLowerCase();
                return q.split(/\s+/).every(function (t) { return hay.indexOf(t) !== -1; });
              }).slice(0, 10)
            : cachedIndex.slice(0, 8);

          if (matches.length === 0) {
            resultsEl.innerHTML = '<div class="p-6 text-center text-sm text-ink-muted">No tools or guides matched "' + escapeHtml(query) + '".</div>';
            activeIdx = -1;
            return;
          }

          activeIdx = 0;
          resultsEl.innerHTML = matches.map(function (item, idx) {
            return (
              '<a href="' + item.href + '" data-gs-idx="' + idx + '" class="gs-item flex items-center justify-between gap-3 px-4 py-3 hover:bg-surface-subtle transition-colors ' + (idx === 0 ? 'bg-surface-subtle/70' : '') + '">' +
                '<div class="min-w-0">' +
                  '<div class="text-sm font-semibold text-ink truncate">' + escapeHtml(item.title) + '</div>' +
                  '<div class="text-xs text-ink-muted truncate">' + escapeHtml(item.description) + '</div>' +
                '</div>' +
                '<span class="shrink-0 font-mono text-[10px] font-semibold uppercase px-2 py-0.5 rounded bg-blueprint-soft text-blueprint">' +
                  escapeHtml(item.type === 'calculator' ? item.categoryName : 'Cost Guide') +
                '</span>' +
              '</a>'
            );
          }).join('');
        }

        function openGlobalSearch() {
          if (!modal || !searchInput) return;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          searchInput.focus();
          if (!cachedIndex) {
            fetch('/search-index.json')
              .then(function (r) { return r.json(); })
              .then(function (data) {
                cachedIndex = data;
                renderGlobalResults(searchInput.value);
              })
              .catch(function () {
                if (resultsEl) resultsEl.innerHTML = '<div class="p-6 text-center text-xs text-ink-muted">Unable to load search index. <a href="/calculators/" class="underline text-blueprint">Open directory</a>.</div>';
              });
          } else {
            renderGlobalResults(searchInput.value);
          }
        }

        function closeGlobalSearch() {
          if (!modal) return;
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }

        if (openBtn) openBtn.addEventListener('click', openGlobalSearch);
        if (closeBtn) closeBtn.addEventListener('click', closeGlobalSearch);
        if (modal) {
          modal.addEventListener('click', function (e) {
            if (e.target === modal) closeGlobalSearch();
          });
        }
        if (searchInput) {
          searchInput.addEventListener('input', function () {
            renderGlobalResults(searchInput.value);
          });
          searchInput.addEventListener('keydown', function (e) {
            var links = resultsEl ? resultsEl.querySelectorAll('.gs-item') : [];
            if (e.key === 'Escape') {
              closeGlobalSearch();
            } else if (e.key === 'ArrowDown' && links.length) {
              e.preventDefault();
              activeIdx = (activeIdx + 1) % links.length;
              for (var i = 0; i < links.length; i++) links[i].classList.toggle('bg-surface-subtle/70', i === activeIdx);
            } else if (e.key === 'ArrowUp' && links.length) {
              e.preventDefault();
              activeIdx = activeIdx <= 0 ? links.length - 1 : activeIdx - 1;
              for (var j = 0; j < links.length; j++) links[j].classList.toggle('bg-surface-subtle/70', j === activeIdx);
            } else if (e.key === 'Enter' && links.length && activeIdx >= 0 && links[activeIdx]) {
              e.preventDefault();
              window.location.href = links[activeIdx].getAttribute('href');
            }
          });
        }

        window.addEventListener('keydown', function (e) {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            if (modal && modal.classList.contains('hidden')) openGlobalSearch();
            else closeGlobalSearch();
          } else if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
            closeGlobalSearch();
          }
        });
      })();
    </script>
  </body>
</html>
