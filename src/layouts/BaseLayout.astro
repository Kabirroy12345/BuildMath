---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { buildPageMeta, type PageMetaInput } from '../lib/seo/meta';
import { buildOrganizationSchema, buildWebSiteSchema } from '../lib/seo/schema';
import ConsentBanner from '../components/ConsentBanner.astro';
import categories from '../data/categories.json';

interface Props extends PageMetaInput {
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  pathname,
  noindex = false,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  schemas = [],
} = Astro.props;

const meta = buildPageMeta({
  title,
  description,
  pathname,
  noindex,
  ogType,
  ogImage,
  publishedTime,
  modifiedTime,
});

const allSchemas = [
  ...(pathname === '/' ? [buildWebSiteSchema(), buildOrganizationSchema()] : []),
  ...schemas,
];
---

<!doctype html>
<html lang={siteConfig.locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={meta.robots} />
    <link rel="canonical" href={meta.canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={meta.ogType} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonicalUrl} />
    <meta property="og:image" content={meta.ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.ogImage} />

    <!-- Theme initialization (no flash) -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('buildmath_theme');
          if (
            theme === 'dark' ||
            (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)
          ) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    {allSchemas.map((schemaObj) => (
      <script type="application/ld+json" set:html={JSON.stringify(schemaObj)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg focus:bg-brand-600 focus:text-white focus:font-semibold"
    >
      Skip to main content
    </a>

    <!-- Header -->
    <header class="sticky top-0 z-30 border-b border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-950/95 backdrop-blur">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 group">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-white font-extrabold text-lg shadow-sm group-hover:bg-brand-700 transition-colors">
            BM
          </span>
          <div>
            <span class="text-lg font-extrabold tracking-tight text-slate-900 dark:text-white">
              {siteConfig.name}
            </span>
            <span class="hidden sm:block text-[11px] text-slate-500 dark:text-slate-400 leading-none">
              Trade-Grade DIY Calculators
            </span>
          </div>
        </a>

        <nav aria-label="Main navigation" class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-700 dark:text-slate-300">
          <a href="/calculators/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
            All Calculators
          </a>
          <a href="/cost/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
            Cost Guides
          </a>
          <a href="/guides/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
            How-To Guides
          </a>
          <a href="/methodology/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
            Methodology
          </a>
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="/my-project/"
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold bg-brand-50 dark:bg-brand-950 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-800 hover:bg-brand-100 transition-colors min-h-[40px]"
          >
            <span>My Project</span>
            <span
              id="project-count-badge"
              class="inline-flex items-center justify-center px-1.5 py-0.5 text-[11px] font-bold rounded-full bg-brand-600 text-white"
            >
              0
            </span>
          </a>

          <button
            id="theme-toggle-btn"
            type="button"
            aria-label="Toggle dark mode"
            class="inline-flex items-center justify-center h-10 w-10 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          >
            <span aria-hidden="true" class="dark:hidden">🌙</span>
            <span aria-hidden="true" class="hidden dark:inline">☀️</span>
          </button>
        </div>
      </div>

      <!-- Mobile Quick Sub-Nav -->
      <nav
        aria-label="Mobile navigation"
        class="md:hidden border-t border-slate-100 dark:border-slate-900 px-4 py-2 flex items-center justify-around text-xs font-semibold text-slate-700 dark:text-slate-300 bg-slate-50/80 dark:bg-slate-900/80"
      >
        <a href="/calculators/" class="py-1 hover:text-brand-600">Calculators</a>
        <a href="/cost/" class="py-1 hover:text-brand-600">Cost Guides</a>
        <a href="/guides/" class="py-1 hover:text-brand-600">How-To Guides</a>
        <a href="/methodology/" class="py-1 hover:text-brand-600">Methodology</a>
      </nav>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-16 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <div>
            <a href="/" class="flex items-center gap-2 font-extrabold text-lg text-slate-900 dark:text-white">
              <span class="flex h-7 w-7 items-center justify-center rounded bg-brand-600 text-white text-sm">
                BM
              </span>
              {siteConfig.name}
            </a>
            <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {siteConfig.description}
            </p>
            <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
              Reviewed by <strong>{siteConfig.author.name}</strong>, {siteConfig.author.role}.
            </p>
          </div>

          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">
              Calculator Categories
            </h2>
            <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
              {categories.map((cat) => (
                <li>
                  <a href={`/calculators/${cat.slug}/`} class="hover:text-brand-600 dark:hover:text-brand-400">
                    {cat.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">
              Popular Tools & Costs
            </h2>
            <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
              <li><a href="/calculators/paint-calculator/" class="hover:text-brand-600">Interior Paint Calculator</a></li>
              <li><a href="/calculators/concrete-slab-calculator/" class="hover:text-brand-600">Concrete Slab Calculator</a></li>
              <li><a href="/calculators/roofing-calculator/" class="hover:text-brand-600">Roofing Shingle Calculator</a></li>
              <li><a href="/calculators/mulch-calculator/" class="hover:text-brand-600">Mulch & Bed Calculator</a></li>
              <li><a href="/calculators/stair-calculator/" class="hover:text-brand-600">Stair Stringer Calculator</a></li>
              <li><a href="/cost/" class="hover:text-brand-600">All 25 Home Improvement Cost Guides</a></li>
              <li><a href="/guides/" class="hover:text-brand-600">DIY Measurement How-To Guides</a></li>
            </ul>
          </div>

          <div>
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">
              About, Trust & Legal
            </h2>
            <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
              <li><a href="/about/" class="hover:text-brand-600">About {siteConfig.name}</a></li>
              <li><a href="/methodology/" class="hover:text-brand-600">Our Formula & Cost Methodology</a></li>
              <li><a href="/contact/" class="hover:text-brand-600">Contact Us</a></li>
              <li><a href="/affiliate-disclosure/" class="hover:text-brand-600">Affiliate Disclosure</a></li>
              <li><a href="/disclaimer/" class="hover:text-brand-600">Construction Disclaimer</a></li>
              <li><a href="/privacy-policy/" class="hover:text-brand-600">Privacy Policy</a></li>
              <li><a href="/cookie-policy/" class="hover:text-brand-600">Cookie Policy</a></li>
              <li><a href="/terms/" class="hover:text-brand-600">Terms of Use</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
          <p>
            © {new Date().getFullYear()} {siteConfig.legalName}. All rights reserved. Estimates are for planning purposes; always verify local building codes before construction.
          </p>
          <p>
            <a href="/sitemap-index.xml" class="hover:underline">XML Sitemap</a> •{' '}
            <a href="/llms.txt" class="hover:underline">LLMs.txt</a>
          </p>
        </div>
      </div>
    </footer>

    <ConsentBanner />

    <script is:inline>
      (function () {
        function updateProjectBadge() {
          try {
            var badge = document.getElementById('project-count-badge');
            if (!badge) return;
            var raw = localStorage.getItem('buildmath_project_list');
            var list = raw ? JSON.parse(raw) : [];
            badge.textContent = String(Array.isArray(list) ? list.length : 0);
          } catch (e) {}
        }

        updateProjectBadge();
        window.addEventListener('buildmath:project-updated', updateProjectBadge);
        window.addEventListener('storage', updateProjectBadge);

        var toggleBtn = document.getElementById('theme-toggle-btn');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', function () {
            var isDark = document.documentElement.classList.toggle('dark');
            try {
              localStorage.setItem('buildmath_theme', isDark ? 'dark' : 'light');
            } catch (e) {}
          });
        }
      })();
    </script>
  </body>
</html>
