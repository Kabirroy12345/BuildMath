---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { buildArticleSchema, type BreadcrumbItem } from '../lib/seo/schema';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  metaTitle: string;
  metaDescription: string;
  pathname: string;
  breadcrumbs: BreadcrumbItem[];
  lastUpdated?: string;
  readingTimeMinutes?: number;
}

const {
  title,
  metaTitle,
  metaDescription,
  pathname,
  breadcrumbs,
  lastUpdated = siteConfig.lastUpdatedDefault,
  readingTimeMinutes,
} = Astro.props;

const articleSchema = buildArticleSchema({
  headline: title,
  description: metaDescription,
  pathname,
  dateModified: lastUpdated,
});
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  pathname={pathname}
  ogType="article"
  modifiedTime={lastUpdated}
  schemas={[articleSchema]}
>
  <Breadcrumbs items={breadcrumbs} />
  <article class="max-w-4xl mx-auto">
    <header class="mb-8 pb-6 border-b border-hairline">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="bm-eyebrow-blue">
          <Icon name="file-text" size={13} />
          Documentation
        </span>
        {readingTimeMinutes && (
          <span class="bm-eyebrow">
            <Icon name="clock" size={13} />
            {readingTimeMinutes} min read
          </span>
        )}
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight leading-tight">
        {title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-ink-muted">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="shield-check" size={14} class="text-blueprint" />
          Compiled by <strong class="text-ink font-semibold">{siteConfig.author.name}</strong> ({siteConfig.author.role})
        </span>
        <span class="font-mono">Updated {lastUpdated}</span>
      </div>
    </header>
    <div class="space-y-6 text-ink-body leading-relaxed text-sm sm:text-base">
      <slot />
    </div>
  </article>
</BaseLayout>
