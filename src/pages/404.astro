---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox, { type SearchableItem } from '../components/SearchBox';
import categories from '../data/categories.json';
import calculators from '../data/calculators.json';

const categoryMap = Object.fromEntries(categories.map((c) => [c.slug, c.name]));
const searchItems: SearchableItem[] = calculators.map((calc) => ({
  slug: calc.slug,
  title: calc.name,
  shortTitle: calc.shortName,
  category: calc.category,
  categoryName: categoryMap[calc.category] || calc.category,
  description: calc.intro,
  href: `/calculators/${calc.slug}/`,
  type: 'calculator',
}));
---

<BaseLayout
  title="Page Not Found (404) | BuildMath"
  description="We couldn't find that page. Search our 32 free DIY home-improvement calculators and state cost guides below."
  pathname="/404.html"
  noindex={true}
>
  <div class="max-w-3xl mx-auto text-center py-12">
    <span class="inline-block text-xs font-bold uppercase tracking-wider text-brand-700 dark:text-brand-300 bg-brand-100 dark:bg-brand-950 px-3 py-1 rounded-full mb-3">
      Error 404 — Measure Twice, Cut Once
    </span>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      We Couldn't Find That Page
    </h1>
    <p class="mt-3 text-base text-slate-600 dark:text-slate-400">
      The link may have moved or been mistyped. Search all 32 calculators below or jump directly to our most popular tools:
    </p>

    <div class="mt-7">
      <SearchBox client:load items={searchItems} />
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a href="/calculators/" class="btn-primary text-sm">Browse All 32 Calculators</a>
      <a href="/cost/" class="btn-secondary text-sm">Explore Cost Guides</a>
      <a href="/" class="btn-secondary text-sm">Back to Homepage</a>
    </div>
  </div>
</BaseLayout>
