---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox, { type SearchableItem } from '../components/SearchBox';
import Icon from '../components/Icon.astro';
import categories from '../data/categories.json';
import calculators from '../data/calculators.json';

const categoryMap = Object.fromEntries(categories.map((c) => [c.slug, c.name]));
const searchItems: SearchableItem[] = calculators.map((calc) => ({
  slug: calc.slug,
  title: calc.name,
  shortTitle: calc.shortName,
  category: calc.category,
  categoryName: categoryMap[calc.category] || calc.category,
  description: calc.intro,
  href: `/calculators/${calc.slug}/`,
  type: 'calculator',
}));
---

<BaseLayout
  title="Page Not Found (404) | BuildMath"
  description="We couldn't find that page. Search our 32 free DIY home-improvement calculators and state cost guides below."
  pathname="/404.html"
  noindex={true}
>
  <div class="max-w-3xl mx-auto text-center py-12 bm-panel p-8 sm:p-12 bm-cad-grid">
    <span class="bm-eyebrow-blue mb-4">
      <Icon name="alert-triangle" size={13} />
      Status 404 // Route Not Found
    </span>
    <h1 class="text-3xl sm:text-5xl font-extrabold text-ink tracking-tight">
      We Couldn't Find That Page
    </h1>
    <p class="mt-3 text-sm sm:text-base text-ink-muted max-w-xl mx-auto leading-relaxed">
      The link may have moved or been mistyped. Search all 32 calculators below or return to one of our main indexes.
    </p>

    <div class="mt-8">
      <SearchBox client:load items={searchItems} />
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/calculators/" class="bm-btn-lime text-sm font-bold">
        <span>Browse All 32 Calculators</span>
        <Icon name="arrow-right" size={15} />
      </a>
      <a href="/cost/" class="bm-btn-secondary text-sm">Explore Cost Guides</a>
      <a href="/" class="bm-btn-secondary text-sm">Back to Homepage</a>
    </div>
  </div>
</BaseLayout>
