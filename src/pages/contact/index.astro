---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../config/site';
---

<ArticleLayout
  title={`Contact ${siteConfig.name}`}
  metaTitle={`Contact ${siteConfig.name}: Questions, Feedback & Formula Requests`}
  metaDescription={`Get in touch with the ${siteConfig.name} editorial and engineering team to report a bug, suggest a new DIY calculator, or ask a question.`}
  pathname="/contact/"
  breadcrumbs={[{ name: 'Contact', href: '/contact/' }]}
>
  <p>
    Questions about one of our calculator formulas, regional labor figures needing an update, or a request for a new estimating tool? Submit the form below or email{' '}
    <a href={`mailto:${siteConfig.email}`} class="text-blueprint font-semibold underline">
      {siteConfig.email}
    </a>.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 my-8">
    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="md:col-span-7 bm-panel p-6 space-y-4"
    >
      <input type="hidden" name="access_key" value={siteConfig.web3FormsAccessKey} />
      <input type="hidden" name="subject" value={`New Contact Message from ${siteConfig.name}`} />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none;" />

      <div>
        <label for="contact-name" class="block text-xs font-semibold text-ink mb-1.5">
          Your Name
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          placeholder="Jane Doe"
          class="bm-input"
        />
      </div>

      <div>
        <label for="contact-email" class="block text-xs font-semibold text-ink mb-1.5">
          Email Address
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          placeholder="jane@example.com"
          class="bm-input"
        />
      </div>

      <div>
        <label for="contact-topic" class="block text-xs font-semibold text-ink mb-1.5">
          Topic
        </label>
        <select id="contact-topic" name="topic" class="bm-input">
          <option value="Calculator Feedback">Calculator Formula / Feedback</option>
          <option value="New Tool Request">Request a New Calculator</option>
          <option value="Cost Data Update">Regional Cost Data Feedback</option>
          <option value="Advertising / Partnership">Advertising or Partnership Inquiry</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div>
        <label for="contact-message" class="block text-xs font-semibold text-ink mb-1.5">
          Message
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          required
          placeholder="Reference the specific calculator slug or state guide..."
          class="bm-input py-2.5"
        ></textarea>
      </div>

      <button type="submit" class="bm-btn-lime w-full font-bold">
        <Icon name="mail" size={16} />
        <span>Send Message</span>
      </button>
    </form>

    <aside class="md:col-span-5 space-y-4">
      <div class="bm-panel p-5">
        <div class="flex items-center gap-2 font-mono text-[11px] text-blueprint mb-2">
          <Icon name="mail" size={14} />
          <span>DIRECT EMAIL</span>
        </div>
        <h2 class="text-base font-bold text-ink mb-1">Editorial &amp; Support</h2>
        <p class="text-sm text-ink-body">
          <a href={`mailto:${siteConfig.email}`} class="text-blueprint underline font-medium">
            {siteConfig.email}
          </a>
        </p>
        <p class="text-xs text-ink-muted mt-2 leading-relaxed">
          All calculator bug reports and formula inquiries are typically reviewed within 1–2 business days.
        </p>
      </div>

      <div class="bm-panel p-5">
        <div class="flex items-center gap-2 font-mono text-[11px] text-ink-muted mb-2">
          <Icon name="file-text" size={14} />
          <span>LEGAL ENTITY</span>
        </div>
        <h2 class="text-base font-bold text-ink mb-1">Compliance Notice</h2>
        <p class="text-xs text-ink-muted leading-relaxed">
          {siteConfig.legalName}<br />
          Attn: Editorial &amp; Compliance Team<br />
          Email: {siteConfig.email}
        </p>
      </div>
    </aside>
  </div>
</ArticleLayout>
