---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { siteConfig } from '../../config/site';
---

<ArticleLayout
  title={`Contact ${siteConfig.name}`}
  metaTitle={`Contact ${siteConfig.name}: Questions, Feedback & Formula Requests`}
  metaDescription={`Get in touch with the ${siteConfig.name} editorial and engineering team to report a bug, suggest a new DIY calculator, or ask a question.`}
  pathname="/contact/"
  breadcrumbs={[{ name: 'Contact', href: '/contact/' }]}
>
  <p>
    Have a question about one of our calculator formulas, spotted a material price that needs updating in your region, or want to request a new home-improvement tool? Send us a message using the form below or email us directly at{' '}
    <a href={`mailto:${siteConfig.email}`} class="text-brand-600 dark:text-brand-400 font-semibold underline">
      {siteConfig.email}
    </a>.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 my-8">
    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="md:col-span-7 card p-6 space-y-4"
    >
      <input type="hidden" name="access_key" value={siteConfig.web3FormsAccessKey} />
      <input type="hidden" name="subject" value={`New Contact Message from ${siteConfig.name}`} />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none;" />

      <div>
        <label for="contact-name" class="block text-sm font-semibold text-slate-800 dark:text-slate-200 mb-1">
          Your Name
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          placeholder="Jane Doe"
          class="input-field"
        />
      </div>

      <div>
        <label for="contact-email" class="block text-sm font-semibold text-slate-800 dark:text-slate-200 mb-1">
          Email Address
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          placeholder="jane@example.com"
          class="input-field"
        />
      </div>

      <div>
        <label for="contact-topic" class="block text-sm font-semibold text-slate-800 dark:text-slate-200 mb-1">
          Topic
        </label>
        <select id="contact-topic" name="topic" class="input-field">
          <option value="Calculator Feedback">Calculator Formula / Feedback</option>
          <option value="New Tool Request">Request a New Calculator</option>
          <option value="Cost Data Update">Regional Cost Data Feedback</option>
          <option value="Advertising / Partnership">Advertising or Partnership Inquiry</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div>
        <label for="contact-message" class="block text-sm font-semibold text-slate-800 dark:text-slate-200 mb-1">
          Message
        </label>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          required
          placeholder="Tell us which calculator or cost guide you are referencing..."
          class="input-field"
        ></textarea>
      </div>

      <button type="submit" class="btn-primary w-full">
        Send Message
      </button>
    </form>

    <aside class="md:col-span-5 space-y-4">
      <div class="card p-5">
        <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">
          Direct Email
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Editorial & Support:{' '}
          <a href={`mailto:${siteConfig.email}`} class="text-brand-600 underline font-medium">
            {siteConfig.email}
          </a>
        </p>
        <p class="text-xs text-slate-500 mt-2">
          We review all calculator bug reports and formula inquiries within 1–2 business days.
        </p>
      </div>

      <div class="card p-5">
        <h2 class="text-base font-bold text-slate-900 dark:text-white mb-1">
          Mailing & Legal Notice
        </h2>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          {siteConfig.legalName}<br />
          Attn: Editorial & Compliance Team<br />
          Email: {siteConfig.email}
        </p>
      </div>
    </aside>
  </div>
</ArticleLayout>
