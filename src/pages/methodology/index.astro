---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../config/site';
import prices from '../../data/prices.json';
---

<ArticleLayout
  title="Our Formula & Cost Estimation Methodology"
  metaTitle="Formula & Cost Methodology: How BuildMath Calculates Estimates"
  metaDescription="See the exact engineering formulas, trade standards (ACI, ARMA, NWFA, IRC), and BLS regional wage multipliers behind BuildMath calculators."
  pathname="/methodology/"
  breadcrumbs={[{ name: 'Methodology', href: '/methodology/' }]}
>
  <section class="bm-panel p-5 sm:p-6 bg-surface-subtle/40">
    <p class="text-sm sm:text-base text-ink leading-relaxed">
      Every calculator and cost guide on <strong>{siteConfig.name}</strong> executes deterministic, unit-tested mathematical functions stored in open TypeScript modules. Default coverage rates, bag yields, and waste allowances are transparent and 100% user-editable.
    </p>
  </section>

  <!-- Animated Calculation Pipeline Workflow Schematic -->
  <section class="my-8 bm-instrument-rim bm-corner-ticks p-5 sm:p-6 bm-cad-grid" aria-label="Deterministic calculation workflow schematic">
    <div class="flex items-center justify-between mb-3 font-mono text-[10px] uppercase tracking-wider text-lime-500">
      <span>DETERMINISTIC PIPELINE ARCHITECTURE // STEP SEQUENCE</span>
      <span class="text-[#6FA3D2]">PURE TYPESCRIPT ENGINE</span>
    </div>
    <svg viewBox="0 0 680 110" class="w-full h-24 sm:h-28" data-draw-svg role="img" aria-label="BuildMath estimation flow diagram from dimensions to retail units and state wages">
      <rect x="10" y="24" width="136" height="58" rx="4" fill="rgba(71,121,168,0.18)" stroke="#6FA3D2" stroke-width="1.6" />
      <rect x="184" y="24" width="136" height="58" rx="4" fill="rgba(71,121,168,0.18)" stroke="#6FA3D2" stroke-width="1.6" />
      <rect x="358" y="24" width="142" height="58" rx="4" fill="rgba(198,243,106,0.18)" stroke="#C6F36A" stroke-width="1.6" />
      <rect x="538" y="24" width="132" height="58" rx="4" fill="rgba(71,121,168,0.18)" stroke="#6FA3D2" stroke-width="1.6" />
      <line x1="146" y1="53" x2="184" y2="53" stroke="#C6F36A" stroke-width="1.8" />
      <line x1="320" y1="53" x2="358" y2="53" stroke="#C6F36A" stroke-width="1.8" />
      <line x1="500" y1="53" x2="538" y2="53" stroke="#C6F36A" stroke-width="1.8" />
      <text x="78" y="48" font-size="9.5" font-family="JetBrains Mono, monospace" fill="#F8F8F5" text-anchor="middle" class="bm-stroke-annotation">01. MEASUREMENTS</text>
      <text x="78" y="64" font-size="8.5" font-family="JetBrains Mono, monospace" fill="#9BA1AA" text-anchor="middle" class="bm-stroke-annotation">ft/in → decimal ft</text>
      <text x="252" y="48" font-size="9.5" font-family="JetBrains Mono, monospace" fill="#F8F8F5" text-anchor="middle" class="bm-stroke-annotation">02. TRADE SPEC</text>
      <text x="252" y="64" font-size="8.5" font-family="JetBrains Mono, monospace" fill="#9BA1AA" text-anchor="middle" class="bm-stroke-annotation">ACI / ARMA / USG + %</text>
      <text x="429" y="48" font-size="9.5" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">03. STORE UNITS</text>
      <text x="429" y="64" font-size="8.5" font-family="JetBrains Mono, monospace" fill="#F8F8F5" text-anchor="middle" class="bm-stroke-annotation">Math.ceil(bags/rolls)</text>
      <text x="604" y="48" font-size="9.5" font-family="JetBrains Mono, monospace" fill="#F8F8F5" text-anchor="middle" class="bm-stroke-annotation">04. STATE INDEX</text>
      <text x="604" y="64" font-size="8.5" font-family="JetBrains Mono, monospace" fill="#6FA3D2" text-anchor="middle" class="bm-stroke-annotation">BLS Wages + BEA RPP</text>
    </svg>
  </section>

  <section class="space-y-4 mt-8">
    <h2 data-split-reveal class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
      1. Material Quantity Formulas &amp; Trade Standards
    </h2>
    <p>
      Our 32 DIY calculators derive their default parameters from published manufacturer technical data sheets (TDS) and residential building codes:
    </p>
    <div class="bm-stagger-grid grid grid-cols-1 gap-3">
      <div class="bm-panel p-4">
        <span class="font-mono text-xs font-semibold text-blueprint">ACI 318 / QUIKRETE / SAKRETE / BIA</span>
        <h3 class="text-sm font-bold text-ink mt-1">Concrete &amp; Masonry</h3>
        <p class="text-xs sm:text-sm text-ink-body mt-1">
          Pre-mixed concrete yields are computed at <code class="font-mono text-ink">0.60 cu ft</code> per 80-lb bag, <code class="font-mono text-ink">0.45 cu ft</code> per 60-lb bag, and <code class="font-mono text-ink">0.30 cu ft</code> per 40-lb bag. Standard modular bricks with a 3/8-inch mortar bed use <code class="font-mono text-ink">6.75 bricks per sq ft</code>.
        </p>
      </div>
      <div class="bm-panel p-4">
        <span class="font-mono text-xs font-semibold text-blueprint">NRCA / ARMA</span>
        <h3 class="text-sm font-bold text-ink mt-1">Roofing &amp; Pitch Geometry</h3>
        <p class="text-xs sm:text-sm text-ink-body mt-1">
          Roof slope multipliers follow the exact right-triangle secant formula <code class="font-mono text-ink">√(1 + (Rise / 12)²)</code>. Asphalt architectural shingles are calculated at 3 bundles per 100 sq ft roofing square.
        </p>
      </div>
      <div class="bm-panel p-4">
        <span class="font-mono text-xs font-semibold text-blueprint">NWFA / TCNA</span>
        <h3 class="text-sm font-bold text-ink mt-1">Flooring &amp; Ceramic Tile</h3>
        <p class="text-xs sm:text-sm text-ink-body mt-1">
          Tile counts incorporate actual grout joint displacement: <code class="font-mono text-ink">ceil(Area_in² / ((W + Grout) × (L + Grout)) × (1 + Waste))</code>.
        </p>
      </div>
      <div class="bm-panel p-4">
        <span class="font-mono text-xs font-semibold text-blueprint">2024 IRC R311.7.5</span>
        <h3 class="text-sm font-bold text-ink mt-1">Stair Stringers &amp; Framing</h3>
        <p class="text-xs sm:text-sm text-ink-body mt-1">
          Stair geometry checks automatically flag code violations against the International Residential Code maximum riser height of <code class="font-mono text-ink">7.75 inches</code> and minimum tread depth of <code class="font-mono text-ink">10.0 inches</code>.
        </p>
      </div>
      <div class="bm-panel p-4">
        <span class="font-mono text-xs font-semibold text-blueprint">USG GYPSUM CONSTRUCTION HANDBOOK</span>
        <h3 class="text-sm font-bold text-ink mt-1">Drywall &amp; Ready-Mix Compound</h3>
        <p class="text-xs sm:text-sm text-ink-body mt-1">
          Standard 4×8 (32 sq ft) and 4×12 (48 sq ft) drywall panels pair with <code class="font-mono text-ink">1.125 gal per 100 sq ft</code> (<code class="font-mono text-ink">0.01125 gal/sq ft</code>, one 4.5-gal pail per 400 sq ft) ready-mixed joint compound, <code class="font-mono text-ink">0.37 linear ft/sq ft</code> joint tape, and <code class="font-mono text-ink">1 screw/sq ft</code>.
        </p>
      </div>
    </div>
  </section>

  <section class="space-y-4 mt-10">
    <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
      2. Regional State Cost Equation
    </h2>
    <p>
      Our localized cost guides combine national bottom-up project pricing with state-level labor and material cost indices:
    </p>
    <div class="bm-instrument-rim p-4 sm:p-5 text-[#F8F8F5] font-mono text-xs sm:text-sm overflow-x-auto">
      <span class="text-lime-500 text-[10px] font-semibold uppercase tracking-wider block mb-1.5">
        Weighted State Multiplier Equation
      </span>
      State_Cost = National_Cost × (Job_Labor_Share × State_Labor_Multiplier + (1 − Job_Labor_Share) × State_Material_Multiplier)
    </div>
    <ul class="space-y-2.5 text-sm sm:text-base">
      <li class="flex items-start gap-2.5">
        <Icon name="check" size={16} class="text-blueprint mt-1 shrink-0" />
        <span>
          <strong class="text-ink">BLS Occupational Employment and Wage Statistics (OEWS):</strong> State labor multipliers reference Bureau of Labor Statistics mean hourly wages across Carpenters (SOC 47-2031), Painters (SOC 47-2141), Roofers (SOC 47-2181), Cement Masons (SOC 47-2051), and Electricians (SOC 47-2111).
        </span>
      </li>
      <li class="flex items-start gap-2.5">
        <Icon name="check" size={16} class="text-blueprint mt-1 shrink-0" />
        <span>
          <strong class="text-ink">BEA Regional Price Parities (RPP):</strong> Regional material indices account for freight, sales tax, and supply-yard pricing differentials published by the US Bureau of Economic Analysis.
        </span>
      </li>
      <li class="flex items-start gap-2.5">
        <Icon name="check" size={16} class="text-blueprint mt-1 shrink-0" />
        <span>
          <strong class="text-ink">Climate &amp; Licensing Links:</strong> Every state profile provides IECC climate zone classifications and direct official contractor licensing board verification links.
        </span>
      </li>
    </ul>
  </section>

  <section class="space-y-4 mt-10">
    <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
      3. National Material Price Dataset
    </h2>
    <p>
      Baseline retail unit prices reflect US home-improvement supplier pricing (Home Depot, Lowe's, regional supply yards) and are editable directly inside every calculator:
    </p>
    <div class="bm-panel overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm tabular-nums">
          <thead>
            <tr class="border-b border-hairline bg-surface-subtle/60 font-mono text-[11px] uppercase text-ink-muted">
              <th class="py-3 px-4 font-semibold">Material Item</th>
              <th class="py-3 px-4 font-semibold">Unit</th>
              <th class="py-3 px-4 font-semibold">Default Price</th>
              <th class="py-3 px-4 font-semibold">Low – High Range</th>
              <th class="py-3 px-4 font-semibold">Reviewed</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            {prices.slice(0, 12).map((p) => (
              <tr class="hover:bg-surface-subtle/40 transition-colors">
                <td class="py-2.5 px-4 font-medium text-ink">{p.name}</td>
                <td class="py-2.5 px-4 font-mono text-ink-muted">{p.unit}</td>
                <td class="py-2.5 px-4 font-mono font-semibold text-ink">${p.defaultPrice}</td>
                <td class="py-2.5 px-4 font-mono text-ink-muted">${p.lowPrice} – ${p.highPrice}</td>
                <td class="py-2.5 px-4 font-mono text-ink-muted">{p.lastReviewed}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</ArticleLayout>
