---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import CalculatorWidget, {
  type ProductItem,
  type CalculatorDiagramType,
} from '../../../components/CalculatorWidget';
import AdSlot from '../../../components/AdSlot.astro';
import FAQSection from '../../../components/FAQSection.astro';
import Icon from '../../../components/Icon.astro';
import { getCategoryIconName } from '../../../lib/lucide-icons';
import { getQuickReferenceTable } from '../../../lib/formulas';
import { siteConfig } from '../../../config/site';
import { monetizationConfig } from '../../../config/monetization';
import calculators from '../../../data/calculators.json';
import categories from '../../../data/categories.json';
import products from '../../../data/products.json';
import jobs from '../../../data/costs/jobs.json';
import states from '../../../data/costs/states.json';

export function getStaticPaths() {
  return calculators.map((calc) => ({
    params: { slug: calc.slug },
    props: { calc },
  }));
}

const { calc } = Astro.props;
const categoryObj = categories.find((c) => c.slug === calc.category)!;
const productsMap: Record<string, ProductItem> = Object.fromEntries(
  products.map((p) => [
    p.id,
    {
      id: p.id,
      name: p.name,
      retailer:
        p.retailer === 'homedepot'
          ? 'Home Depot'
          : p.retailer === 'amazon'
            ? 'Amazon'
            : p.retailer,
      priceIndication: p.note || '',
    },
  ])
);

const qrMeta = calc.quickReferenceMeta;
const quickRefTable = getQuickReferenceTable(
  calc.slug,
  qrMeta
    ? ['Project Size / Scenario', qrMeta.col1Header, qrMeta.col2Header, qrMeta.col3Header]
    : undefined,
  qrMeta?.title || `${calc.shortName} Quick-Reference Chart`
);

const relatedCalcs = (calc.relatedCalculators || [])
  .map((slug) => calculators.find((c) => c.slug === slug))
  .filter(Boolean);

const relatedJob = jobs.find((j) => j.slug === calc.relatedCostJobSlug) || jobs[0];
const sampleStates = states.slice(0, 6);

const diagramMap: Record<string, CalculatorDiagramType> = {
  'paint-calculator': 'paint-elevation',
  'exterior-paint-calculator': 'paint-elevation',
  'deck-stain-calculator': 'paint-elevation',
  'wallpaper-calculator': 'paint-elevation',
  'drywall-calculator': 'paint-elevation',
  'baseboard-trim-calculator': 'paint-elevation',
  'roof-pitch-calculator': 'roof-pitch',
  'roofing-calculator': 'roof-pitch',
  'gutter-calculator': 'roof-pitch',
  'siding-calculator': 'roof-pitch',
  'stair-calculator': 'stair-stringer',
  'concrete-steps-calculator': 'stair-stringer',
  'fence-calculator': 'fence-layout',
  'concrete-slab-calculator': 'concrete-slab',
  'cubic-yard-calculator': 'concrete-slab',
  'rebar-calculator': 'concrete-slab',
  'retaining-wall-calculator': 'concrete-slab',
  'brick-calculator': 'concrete-slab',
  'concrete-footing-calculator': 'concrete-footing',
  'deck-calculator': 'flooring-grid',
  'paver-patio-calculator': 'flooring-grid',
  'tile-calculator': 'flooring-grid',
  'flooring-calculator': 'flooring-grid',
  'grout-calculator': 'flooring-grid',
  'carpet-calculator': 'flooring-grid',
  'square-footage-calculator': 'flooring-grid',
  'board-foot-calculator': 'flooring-grid',
  'mulch-calculator': 'bed-volume',
  'gravel-calculator': 'bed-volume',
  'topsoil-calculator': 'bed-volume',
  'sod-calculator': 'bed-volume',
  'grass-seed-calculator': 'bed-volume',
};
const diagramType = diagramMap[calc.slug] || null;
---

<CalculatorLayout
  title={calc.name}
  metaTitle={calc.metaTitle}
  metaDescription={calc.metaDescription}
  pathname={`/calculators/${calc.slug}/`}
  categoryName={categoryObj.name}
  lastUpdated={calc.lastReviewed || siteConfig.lastUpdatedDefault}
  breadcrumbs={[
    { name: 'Calculators', href: '/calculators/' },
    { name: categoryObj.name, href: `/calculators/${categoryObj.slug}/` },
    { name: calc.shortName, href: `/calculators/${calc.slug}/` },
  ]}
>
  <!-- 1. Compact Technical Instrument Header -->
  <header class="mb-5 pb-5 border-b border-hairline flex flex-col lg:flex-row lg:items-end justify-between gap-4">
    <div>
      <div class="flex flex-wrap items-center gap-2 mb-2.5">
        <a
          href={`/calculators/${categoryObj.slug}/`}
          class="bm-eyebrow-blue hover:opacity-85 transition-opacity"
        >
          <Icon name={getCategoryIconName(categoryObj.slug)} size={12} />
          {categoryObj.name}
        </a>
        <span class="bm-eyebrow">Source-Cited Formula</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight">
        {calc.h1 || calc.name}
      </h1>
      <p class="mt-2 text-sm sm:text-base text-ink-body max-w-3xl leading-relaxed">
        {calc.intro}
      </p>
    </div>

    <div class="flex items-center gap-2 shrink-0 text-xs font-mono text-ink-muted">
      <Icon name="shield-check" size={15} class="text-blueprint" />
      <span>Verified {calc.lastReviewed || siteConfig.lastUpdatedDefault}</span>
    </div>
  </header>

  <!-- 2. Interactive Calculator Workbench (Inputs left, Graphite Readout right) -->
  <CalculatorWidget
    client:load
    slug={calc.slug}
    title={calc.name}
    shortName={calc.shortName}
    category={calc.category}
    categoryName={categoryObj.name}
    fields={calc.inputs}
    diagramType={diagramType}
    productsMap={productsMap}
    affiliateDisclosure={monetizationConfig.affiliateDisclosureShort}
    affiliateEnabled={monetizationConfig.affiliateEnabled}
  />

  <!-- 3. Ad slot #1 (strictly below calculator widget) -->
  <AdSlot position="belowCalculator" />

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-10">
    <div class="lg:col-span-8 space-y-8">
      <!-- 4. Quick-reference table -->
      {quickRefTable && (
        <section class="bm-panel overflow-hidden" aria-labelledby="quick-ref-heading">
          <div class="px-5 sm:px-6 py-4 border-b border-hairline bg-surface-subtle/40">
            <span class="font-mono text-[10px] uppercase tracking-wider text-blueprint">
              Reference Specification Table
            </span>
            <h2 id="quick-ref-heading" class="text-lg sm:text-xl font-bold text-ink mt-0.5">
              {quickRefTable.title}
            </h2>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs sm:text-sm tabular-nums">
              <thead>
                <tr class="border-b border-hairline bg-surface-subtle/60">
                  {quickRefTable.headers.map((h) => (
                    <th class="py-3 px-4 font-mono text-[11px] font-semibold uppercase tracking-wider text-ink-muted">
                      {h}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                {quickRefTable.rows.map((row) => (
                  <tr class="hover:bg-surface-subtle/40 transition-colors">
                    {row.map((cell, idx) => (
                      <td class={`py-2.5 px-4 ${idx === 0 ? 'font-semibold text-ink' : 'text-ink-body font-mono text-xs sm:text-sm'}`}>
                        {cell}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {quickRefTable.footnote && (
            <p class="px-5 py-3 border-t border-hairline bg-surface-subtle/30 text-xs text-ink-muted">
              {quickRefTable.footnote}
            </p>
          )}
        </section>
      )}

      <!-- 5. How the calculation works -->
      <section class="bm-panel p-5 sm:p-6 space-y-5" aria-labelledby="how-it-works-heading">
        <div>
          <span class="bm-eyebrow mb-2">Mathematical Spec</span>
          <h2 id="how-it-works-heading" class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
            How the {calc.shortName} Calculation Works
          </h2>
        </div>

        <div class="p-4 rounded-lg bg-graphite-900 text-[#F8F8F5] border border-graphite-700 font-mono text-xs sm:text-sm overflow-x-auto">
          <span class="text-lime-500 font-semibold uppercase tracking-wider block text-[10px] mb-1.5">
            Formula Specification
          </span>
          {calc.howToCalculate.formula}
        </div>

        <ol class="space-y-2.5 text-sm text-ink-body">
          {calc.howToCalculate.steps.map((st, idx) => (
            <li class="flex items-start gap-3">
              <span class="font-mono text-xs font-bold text-blueprint bg-blueprint-soft px-2 py-0.5 rounded mt-0.5 shrink-0 tabular-nums">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <span class="leading-relaxed">{st}</span>
            </li>
          ))}
        </ol>

        <div class="p-4 sm:p-5 rounded-lg bg-surface-subtle/60 border border-hairline border-l-4 border-l-blueprint space-y-2.5">
          <h3 class="text-sm font-bold text-ink">
            Worked Example: {calc.howToCalculate.workedExample.title}
          </h3>
          <p class="text-xs sm:text-sm text-ink-body leading-relaxed">
            {calc.howToCalculate.workedExample.scenario}
          </p>
          <ul class="space-y-1 text-xs sm:text-sm text-ink-body font-mono">
            {calc.howToCalculate.workedExample.steps.map((s) => (
              <li class="flex items-start gap-2">
                <span class="text-blueprint">→</span>
                <span>{s}</span>
              </li>
            ))}
          </ul>
          <p class="text-xs sm:text-sm font-bold text-ink pt-1.5 border-t border-hairline">
            Final Result: <span class="text-blueprint">{calc.howToCalculate.workedExample.finalAnswer}</span>
          </p>
        </div>
      </section>

      <!-- 6. Practical tips & common mistakes -->
      <section class="bm-panel p-5 sm:p-6" aria-labelledby="tips-heading">
        <span class="bm-eyebrow mb-2">Field Best Practices</span>
        <h2 id="tips-heading" class="text-xl sm:text-2xl font-bold text-ink tracking-tight mb-4">
          Practical Trade Tips &amp; Mistakes to Avoid
        </h2>
        <ul class="space-y-3">
          {calc.tipsAndMistakes.map((tip) => (
            <li class="flex items-start gap-3 text-sm text-ink-body leading-relaxed">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-lime-500/20 text-ink mt-0.5">
                <Icon name="check" size={14} class="text-ink dark:text-lime-500" />
              </span>
              <span>{tip}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- 7. "What it might cost" DIY vs Pro comparison -->
      <section class="bm-panel p-5 sm:p-6 bg-surface-subtle/40" aria-labelledby="cost-box-heading">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 mb-4 border-b border-hairline">
          <div>
            <span class="bm-eyebrow-blue mb-1.5">DIY vs. Installed Cost</span>
            <h2 id="cost-box-heading" class="text-lg sm:text-xl font-bold text-ink">
              What {relatedJob.name} Costs Professionally Installed
            </h2>
          </div>
          <a href={`/cost/${relatedJob.slug}/`} class="bm-btn-graphite text-xs shrink-0">
            <span>National Cost Guide</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </div>

        <p class="text-sm text-ink-body mb-4 leading-relaxed tabular-nums">
          Hiring a licensed contractor for <strong>{relatedJob.name.toLowerCase()}</strong> averages{' '}
          <strong class="text-ink">${Math.round(relatedJob.nationalTypicalPerUnit * relatedJob.typicalProjectSize).toLocaleString()}</strong> nationally (range:{' '}
          <strong class="text-ink">${Math.round(relatedJob.nationalLowPerUnit * relatedJob.typicalProjectSize).toLocaleString()} – ${Math.round(relatedJob.nationalHighPerUnit * relatedJob.typicalProjectSize).toLocaleString()}</strong> for {relatedJob.typicalProjectSize.toLocaleString()} {relatedJob.unit}), with labor representing roughly {Math.round(relatedJob.laborShare * 100)}% of total billing.
        </p>

        <div>
          <span class="block font-mono text-[11px] uppercase tracking-wider text-ink-muted mb-2.5">
            Compare {relatedJob.name} Local Rates:
          </span>
          <div class="flex flex-wrap gap-2">
            {sampleStates.map((st) => (
              <a
                href={`/cost/${relatedJob.slug}/${st.slug}/`}
                class="px-3 py-1.5 rounded-md text-xs font-medium bg-surface border border-hairline hover:border-blueprint text-ink transition-colors"
              >
                {st.name}
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- 8. Ad slot #2 -->
      <AdSlot position="inContent" />

      <!-- 9. FAQ -->
      <FAQSection
        faqs={calc.faqs}
        title={`${calc.shortName} Calculator: Frequently Asked Questions`}
      />

      <!-- 10. Source attribution footer -->
      <footer class="bm-panel p-5 bg-surface-subtle/50 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-ink-muted">
        <div>
          <p class="font-semibold text-ink">
            Formula &amp; Standards Compiled by {siteConfig.author.name}
          </p>
          <p class="mt-0.5">
            {siteConfig.author.role} · {siteConfig.author.credentials}
          </p>
        </div>
        <div class="sm:text-right shrink-0 space-y-1">
          <p class="font-mono">Last Reviewed: <strong class="text-ink">{calc.lastReviewed || siteConfig.lastUpdatedDefault}</strong></p>
          <a href="/methodology/" class="inline-flex items-center gap-1 text-blueprint font-semibold hover:underline">
            <span>Formula Methodology</span>
            <Icon name="arrow-right" size={13} />
          </a>
        </div>
      </footer>
    </div>

    <!-- Sidebar: Related Calculators -->
    <aside class="lg:col-span-4 space-y-6">
      <div class="bm-panel p-5 lg:sticky lg:top-20">
        <div class="flex items-center justify-between gap-2 mb-3.5">
          <h2 class="text-sm font-mono font-semibold uppercase tracking-wider text-ink">
            Related Instruments
          </h2>
          <Icon name="compass" size={15} class="text-blueprint" />
        </div>

        <ul class="space-y-2">
          {relatedCalcs.map((rc) => (
            <li>
              <a
                href={`/calculators/${rc.slug}/`}
                class="block p-3 rounded-lg bg-canvas border border-hairline hover:border-blueprint transition-colors group"
              >
                <div class="flex items-center justify-between gap-2">
                  <span class="text-sm font-semibold text-ink group-hover:text-blueprint transition-colors">
                    {rc.name}
                  </span>
                  <Icon name="arrow-right" size={13} class="text-ink-muted group-hover:text-blueprint shrink-0" />
                </div>
                <div class="text-xs text-ink-muted line-clamp-1 mt-1">
                  {rc.intro}
                </div>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-5 pt-4 border-t border-hairline space-y-2.5">
          <a
            href={`/calculators/${categoryObj.slug}/`}
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-blueprint hover:underline"
          >
            <Icon name="chevron-left" size={14} />
            <span>All {categoryObj.name} Calculators</span>
          </a>
        </div>
      </div>
    </aside>
  </div>
</CalculatorLayout>
