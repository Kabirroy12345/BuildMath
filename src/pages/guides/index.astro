---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import guides from '../../data/guides.json';
import calculators from '../../data/calculators.json';
---

<BaseLayout
  title="DIY Home Improvement Measurement & Material Guides | BuildMath"
  description="Step-by-step measurement and material estimation guides for painting, concrete slabs, roofing pitch, flooring waste factors, and landscaping beds."
  pathname="/guides/"
>
  <Breadcrumbs items={[{ name: 'How-To Guides', href: '/guides/' }]} />

  <header class="mb-8 pb-6 border-b border-hairline">
    <span class="bm-eyebrow-blue mb-2.5">
      <Icon name="book-open" size={13} />
      Field Reference Library // {guides.length} Guides
    </span>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight">
      DIY Measurement &amp; Estimation Guides
    </h1>
    <p class="mt-2 text-sm sm:text-base text-ink-muted max-w-3xl leading-relaxed">
      Practical, repeatable field procedures showing how residential estimators measure wall surfaces, gauge roof slope safely from the ground, and set material waste margins.
    </p>
  </header>

  <div class="bm-stagger-grid grid grid-cols-1 md:grid-cols-2 gap-5">
    {guides.map((guide, idx) => {
      const relatedCalcs = (guide.relatedCalculators || [])
        .map((slug) => calculators.find((c) => c.slug === slug))
        .filter(Boolean);
      return (
        <article class="bm-panel bm-card-invert p-6 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 text-xs font-mono text-ink-muted mb-3">
              <span class="bm-invert-badge px-2 py-0.5 rounded bg-blueprint-soft text-blueprint font-semibold border border-transparent transition-colors">
                FIELD MANUAL #{String(idx + 1).padStart(2, '0')}
              </span>
              <span class="inline-flex items-center gap-1.5">
                <Icon name="clock" size={12} />
                {guide.readingTime} · Updated {guide.lastReviewed}
              </span>
            </div>
            <h2 class="text-xl font-bold text-ink">
              <a href={`/guides/${guide.slug}/`} class="hover:text-blueprint transition-colors">
                {guide.title}
              </a>
            </h2>
            <p class="mt-2 text-sm text-ink-muted leading-relaxed">
              {guide.excerpt}
            </p>
          </div>

          <div class="mt-5 pt-4 border-t border-hairline flex flex-wrap items-center justify-between gap-2">
            <a
              href={`/guides/${guide.slug}/`}
              class="inline-flex items-center gap-1.5 text-xs font-bold text-blueprint hover:underline"
            >
              <span>Read Full Guide</span>
              <Icon name="arrow-right" size={14} />
            </a>
            <div class="flex flex-wrap gap-1.5">
              {relatedCalcs.slice(0, 2).map((rc) => (
                <a
                  href={`/calculators/${rc.slug}/`}
                  class="font-mono text-[11px] px-2 py-1 rounded bg-canvas border border-hairline text-ink-body hover:border-blueprint hover:text-blueprint transition-colors"
                >
                  {rc.shortName} Calc
                </a>
              ))}
            </div>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>
