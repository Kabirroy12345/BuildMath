---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import FAQSection from '../../../components/FAQSection.astro';
import Icon from '../../../components/Icon.astro';
import guides from '../../../data/guides.json';
import calculators from '../../../data/calculators.json';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const relatedCalcs = (guide.relatedCalculators || [])
  .map((slug: string) => calculators.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
---

<ArticleLayout
  title={guide.title}
  metaTitle={guide.metaTitle}
  metaDescription={guide.metaDescription}
  pathname={`/guides/${guide.slug}/`}
  lastUpdated={guide.lastReviewed}
  breadcrumbs={[
    { name: 'How-To Guides', href: '/guides/' },
    { name: guide.title, href: `/guides/${guide.slug}/` },
  ]}
>
  <div class="p-5 rounded-xl bg-surface border border-hairline border-l-4 border-l-blueprint text-sm sm:text-base font-medium text-ink leading-relaxed">
    {guide.excerpt}
  </div>

  {guide.sections.map((sec, idx) => (
    <section class="mt-8">
      <div class="flex items-center gap-2 mb-2">
        <span class="font-mono text-xs font-bold text-blueprint">
          {String(idx + 1).padStart(2, '0')} //
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
          {sec.heading}
        </h2>
      </div>
      <p class="text-sm sm:text-base text-ink-body leading-relaxed">
        {sec.body}
      </p>
    </section>
  ))}

  {relatedCalcs.length > 0 && (
    <section class="my-10 bm-panel p-5 sm:p-6 bg-surface-subtle/40">
      <div class="flex items-center gap-2 mb-3">
        <Icon name="calculator" size={16} class="text-blueprint" />
        <h2 class="text-base sm:text-lg font-bold text-ink">
          Run These Numbers with Interactive Calculators
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {relatedCalcs.map((rc) => (
          <a
            href={`/calculators/${rc.slug}/`}
            class="bm-panel bm-panel-hover p-4 group hover:border-blueprint/70"
          >
            <div class="text-sm font-bold text-ink group-hover:text-blueprint transition-colors">
              {rc.name}
            </div>
            <div class="text-xs text-ink-muted mt-1 line-clamp-2">
              {rc.intro}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <FAQSection faqs={guide.faqs} />
</ArticleLayout>
