---
import products from '../../../data/products.json';
import { monetizationConfig } from '../../../config/monetization';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const shouldAppendAmazonTag =
  monetizationConfig.affiliateEnabled &&
  Boolean(monetizationConfig.amazonAssociateTag) &&
  product.url.includes('amazon.com');

const targetUrl = shouldAppendAmazonTag
  ? `${product.url}${product.url.includes('?') ? '&' : '?'}tag=${monetizationConfig.amazonAssociateTag}`
  : product.url;

const relAttr = monetizationConfig.affiliateEnabled
  ? 'sponsored nofollow noopener'
  : 'nofollow noopener';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to {product.retailer} – {product.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href={targetUrl} />
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 3rem 1.5rem; text-align: center; background: #F8F8F5; color: #17191C;">
    <p style="font-size: 0.95rem;">
      Redirecting to <strong>{product.name}</strong> at {product.retailer}...
    </p>
    <p style="font-size: 0.85rem;">
      <a href={targetUrl} rel={relAttr} style="color: #4779A8; font-weight: 600;">Click here if you are not redirected automatically</a>.
    </p>
    <script is:inline define:vars={{ targetUrl }}>
      window.location.replace(targetUrl);
    </script>
  </body>
</html>
