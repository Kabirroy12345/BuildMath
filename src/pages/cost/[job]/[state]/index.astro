---
import CostLayout from '../../../../layouts/CostLayout.astro';
import StateCostEstimator from '../../../../components/StateCostEstimator';
import LeadGenWidget from '../../../../components/LeadGenWidget.astro';
import FAQSection from '../../../../components/FAQSection.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import Icon from '../../../../components/Icon.astro';
import { calculateStateJobCost } from '../../../../lib/formulas/state-cost';
import { shouldIndexCostPage } from '../../../../config/seo';
import jobs from '../../../../data/costs/jobs.json';
import states from '../../../../data/costs/states.json';

export function getStaticPaths() {
  const paths = [];
  for (const job of jobs) {
    for (const state of states) {
      paths.push({
        params: { job: job.slug, state: state.slug },
        props: { job, state },
      });
    }
  }
  return paths;
}

const { job, state } = Astro.props;
const estimate = calculateStateJobCost(job as any, state as any);
const shouldIndex = shouldIndexCostPage(job.verified, state.slug);

const diffWord =
  estimate.percentDiffVsNational > 0
    ? `${estimate.percentDiffVsNational}% above`
    : estimate.percentDiffVsNational < 0
      ? `${Math.abs(estimate.percentDiffVsNational)}% below`
      : 'equal to';

const tradeHourlyWage = estimate.stateTradeWage;

const neighborStates = (state.neighbors || [])
  .map((slug: string) => states.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const currentYear = new Date().getFullYear();

const faqs = [
  {
    question: `How much does ${job.name.toLowerCase()} cost in ${state.name} in ${currentYear}?`,
    answer: `In ${state.name}, ${job.name.toLowerCase()} costs an average of $${estimate.typical.toLocaleString()} for a typical ${job.typicalProjectSize.toLocaleString()} ${job.unit} project, with most homeowners paying between $${estimate.low.toLocaleString()} and $${estimate.high.toLocaleString()} ($${estimate.lowPerUnit} to $${estimate.highPerUnit} per ${job.unit}). This is ${diffWord} the US national average of $${estimate.nationalTotalTypical.toLocaleString()}.`,
  },
  {
    question: `What is the average labor rate for ${job.tradeName.toLowerCase()} in ${state.name}?`,
    answer: `According to Bureau of Labor Statistics (BLS OEWS, SOC ${job.socCode}) data for ${state.name}, the mean base hourly wage for ${job.tradeName.toLowerCase()} is $${tradeHourlyWage.toFixed(2)}/hr. Once contractor overhead, workers' compensation, liability insurance, and profit are included, billed residential labor rates in ${state.name} typically run $${Math.round(tradeHourlyWage * 2.1)} to $${Math.round(tradeHourlyWage * 2.75)} per hour.`,
  },
  {
    question: `Do I need a permit or licensed contractor for ${job.name.toLowerCase()} in ${state.name}?`,
    answer: `${state.permitNote} Always verify contractor credentials directly with the ${state.licensingBoardName}.`,
  },
  {
    question: `How do ${state.name} climate conditions affect ${job.name.toLowerCase()}?`,
    answer: `${state.name} is located in ${state.climateZone}. ${state.climateConsiderations}`,
  },
];
---

<CostLayout
  title={`Cost of ${job.name} in ${state.name} (${currentYear} Local Price Guide)`}
  metaTitle={`${job.name} Cost in ${state.name}: $${estimate.low.toLocaleString()}–$${estimate.high.toLocaleString()}`}
  metaDescription={`How much does ${job.name.toLowerCase()} cost in ${state.name}? Typical price is $${estimate.typical.toLocaleString()} ($${estimate.lowPerUnit}–$${estimate.highPerUnit}/${job.unit}), ${diffWord} the US average.`}
  pathname={`/cost/${job.slug}/${state.slug}/`}
  noindex={!shouldIndex}
  lastUpdated={job.verified && job.lastReviewed ? job.lastReviewed : undefined}
  breadcrumbs={[
    { name: 'Cost Guides', href: '/cost/' },
    { name: job.name, href: `/cost/${job.slug}/` },
    { name: state.name, href: `/cost/${job.slug}/${state.slug}/` },
  ]}
>
  {!job.verified && (
    <div class="mb-5 p-3.5 rounded-lg bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-800 text-xs text-amber-900 dark:text-amber-200 flex items-start gap-2.5">
      <Icon name="alert-triangle" size={16} class="shrink-0 mt-0.5" />
      <span>
        <strong>Preliminary Draft Estimate:</strong> This trade guide uses our material calculator baseline and BLS wage ratios for {state.name} while full line-item verification is in progress (excluded from search indexing).
      </span>
    </div>
  )}

  <header class="mb-5">
    <div class="flex flex-wrap items-center gap-2 mb-2.5">
      <span class="bm-eyebrow-blue">
        <Icon name="map-pin" size={12} />
        {state.name} ({state.abbr}) Regional Model
      </span>
      {job.verified && (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded bg-lime-500/20 text-ink dark:text-lime-500 border border-lime-500/40 font-mono text-[11px] font-semibold">
          <span class="h-1.5 w-1.5 rounded-full bg-lime-500"></span>
          Bottom-Up Verified
        </span>
      )}
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-ink tracking-tight">
      Cost of {job.name} in {state.name} ({currentYear})
    </h1>
  </header>

  <!-- Summary Answer Box -->
  <section aria-label="Quick cost summary" class="bm-panel overflow-hidden mb-6">
    <div class="p-5 sm:p-6 border-b border-hairline">
      <p class="text-sm sm:text-base text-ink-body leading-relaxed">
        In <strong class="text-ink">{state.name}</strong>, the typical cost for <strong class="text-ink">{job.name.toLowerCase()}</strong> is{' '}
        <strong class="text-blueprint">${estimate.typical.toLocaleString()}</strong> for a standard{' '}
        {job.typicalProjectSize.toLocaleString()} {job.unit} project, with most homeowners paying between{' '}
        <strong class="text-ink">${estimate.low.toLocaleString()} and ${estimate.high.toLocaleString()}</strong> (${estimate.lowPerUnit} – ${estimate.highPerUnit} per {job.unit}). Overall project pricing in {state.name} runs{' '}
        <strong class="text-ink">{diffWord}</strong> the US national average of ${estimate.nationalTotalTypical.toLocaleString()}.
      </p>
    </div>

    <div class="bg-graphite-900 p-4 sm:p-5 grid grid-cols-2 sm:grid-cols-4 gap-3 text-left">
      <div class="p-3.5 rounded-lg bg-graphite-950 border border-graphite-700">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#9BA1AA] block">Typical {state.abbr} Cost</span>
        <strong class="text-xl sm:text-2xl font-extrabold text-lime-500 tabular-nums mt-1 block">
          ${estimate.typical.toLocaleString()}
        </strong>
      </div>
      <div class="p-3.5 rounded-lg bg-graphite-950 border border-graphite-700">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#9BA1AA] block">Low – High Range</span>
        <strong class="text-base sm:text-lg font-bold text-[#F8F8F5] tabular-nums mt-1 block">
          ${estimate.low.toLocaleString()} – ${estimate.high.toLocaleString()}
        </strong>
      </div>
      <div class="p-3.5 rounded-lg bg-graphite-950 border border-graphite-700">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#9BA1AA] block">Per {job.unit}</span>
        <strong class="text-base sm:text-lg font-bold text-[#6FA3D2] tabular-nums mt-1 block">
          ${estimate.lowPerUnit} – ${estimate.highPerUnit}
        </strong>
      </div>
      <div class="p-3.5 rounded-lg bg-graphite-950 border border-graphite-700">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#9BA1AA] block">vs. National Avg</span>
        <strong
          class={`text-base sm:text-lg font-bold font-mono tabular-nums mt-1 block ${
            estimate.percentDiffVsNational > 0 ? 'text-amber-400' : 'text-lime-500'
          }`}
        >
          {estimate.percentDiffVsNational > 0 ? '+' : ''}{estimate.percentDiffVsNational}%
        </strong>
      </div>
    </div>
  </section>

  <!-- Interactive State Estimator -->
  <StateCostEstimator
    client:load
    job={job}
    state={state}
    relatedCalculatorSlug={job.relatedCalculatorSlug}
  />

  <AdSlot position="belowCalculator" />

  <!-- Materials vs Labor Table -->
  <section class="bm-panel overflow-hidden my-8" aria-labelledby="breakdown-heading">
    <div class="px-5 sm:px-6 py-4 border-b border-hairline bg-surface-subtle/40">
      <h2 id="breakdown-heading" class="text-lg sm:text-xl font-bold text-ink">
        {state.name} {job.name}: Materials vs. Labor Breakdown
      </h2>
      <p class="text-xs sm:text-sm text-ink-muted mt-1 tabular-nums">
        Itemized estimate for {job.typicalProjectSize.toLocaleString()} {job.unit} in {state.name} (labor index: {(estimate.laborMultiplier * 100).toFixed(0)}%, BEA RPP material index: {state.rpp}%)
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs sm:text-sm tabular-nums">
        <thead>
          <tr class="border-b border-hairline bg-surface-subtle/60 font-mono text-[11px] uppercase text-ink-muted">
            <th class="py-3 px-4 font-semibold">Expense Category</th>
            <th class="py-3 px-4 font-semibold">Share</th>
            <th class="py-3 px-4 font-semibold">Low ({state.abbr})</th>
            <th class="py-3 px-4 font-semibold">Typical ({state.abbr})</th>
            <th class="py-3 px-4 font-semibold">High ({state.abbr})</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          <tr>
            <td class="py-3 px-4 font-semibold text-ink">
              Contractor Labor ({job.tradeName})
            </td>
            <td class="py-3 px-4 font-mono text-ink-muted">{Math.round(job.laborShare * 100)}%</td>
            <td class="py-3 px-4 font-mono">${Math.round(estimate.low * job.laborShare).toLocaleString()}</td>
            <td class="py-3 px-4 font-mono font-bold text-ink">${estimate.laborCost.toLocaleString()}</td>
            <td class="py-3 px-4 font-mono">${Math.round(estimate.high * job.laborShare).toLocaleString()}</td>
          </tr>
          {job.materialsBreakdown.map((m) => {
            const matShare = (1 - job.laborShare) * (m.sharePercent / 100);
            return (
              <tr>
                <td class="py-3 px-4 text-ink-body">{m.item}</td>
                <td class="py-3 px-4 font-mono text-ink-muted">{Math.round(matShare * 100)}%</td>
                <td class="py-3 px-4 font-mono text-ink-muted">${Math.round(estimate.low * matShare).toLocaleString()}</td>
                <td class="py-3 px-4 font-mono font-semibold text-ink">${Math.round(estimate.materialCost * (m.sharePercent / 100)).toLocaleString()}</td>
                <td class="py-3 px-4 font-mono text-ink-muted">${Math.round(estimate.high * matShare).toLocaleString()}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <!-- State-Specific Factors -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-4 my-8" aria-labelledby="state-factors-heading">
    <h2 id="state-factors-heading" class="sr-only">
      {state.name}-Specific Labor, Climate, and Licensing Factors
    </h2>

    <div class="bm-panel p-5">
      <div class="flex items-center justify-between mb-2">
        <span class="font-mono text-[10px] font-semibold uppercase tracking-wider text-blueprint">
          01 // Trade Wages (BLS)
        </span>
        <Icon name="wrench" size={15} class="text-ink-muted" />
      </div>
      <h3 class="text-base font-bold text-ink">
        {job.tradeName} in {state.name}
      </h3>
      <p class="text-xs sm:text-sm text-ink-body mt-2 leading-relaxed tabular-nums">
        Per Bureau of Labor Statistics (SOC {job.socCode}), the mean hourly wage in {state.name} is{' '}
        <strong class="text-ink">${tradeHourlyWage.toFixed(2)}/hr</strong> (vs. ${job.nationalTradeWage.toFixed(2)}/hr US average). Billed contractor rates typically range{' '}
        <strong class="text-ink">${Math.round(tradeHourlyWage * 2.1)}–${Math.round(tradeHourlyWage * 2.75)}/hr</strong>.
      </p>
    </div>

    <div class="bm-panel p-5">
      <div class="flex items-center justify-between mb-2">
        <span class="font-mono text-[10px] font-semibold uppercase tracking-wider text-blueprint">
          02 // Climate &amp; Specs
        </span>
        <Icon name="compass" size={15} class="text-ink-muted" />
      </div>
      <h3 class="text-base font-bold text-ink">
        {state.climateZone}
      </h3>
      <p class="text-xs sm:text-sm text-ink-body mt-2 leading-relaxed">
        {state.climateConsiderations}
      </p>
    </div>

    <div class="bm-panel p-5 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono text-[10px] font-semibold uppercase tracking-wider text-blueprint">
            03 // Permits &amp; Licensing
          </span>
          <Icon name="shield-check" size={15} class="text-ink-muted" />
        </div>
        <h3 class="text-base font-bold text-ink">
          {state.licensingBoardName}
        </h3>
        <p class="text-xs sm:text-sm text-ink-body mt-2 leading-relaxed">
          {state.permitNote}
        </p>
      </div>
      <a
        href={state.licensingBoardUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3.5 inline-flex items-center gap-1.5 text-xs font-semibold text-blueprint hover:underline"
      >
        <span>Verify a {state.name} License</span>
        <Icon name="external-link" size={13} />
      </a>
    </div>
  </section>

  <!-- Neighboring States Comparison -->
  {neighborStates.length > 0 && (
    <section class="bm-panel overflow-hidden my-8" aria-labelledby="neighbors-heading">
      <div class="px-5 sm:px-6 py-4 border-b border-hairline bg-surface-subtle/40">
        <h2 id="neighbors-heading" class="text-lg font-bold text-ink">
          How {state.name} Compares to Neighboring States
        </h2>
        <p class="text-xs sm:text-sm text-ink-muted mt-0.5 tabular-nums">
          Regional comparison for {job.typicalProjectSize.toLocaleString()} {job.unit} of {job.name.toLowerCase()}
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs sm:text-sm tabular-nums">
          <thead>
            <tr class="border-b border-hairline bg-surface-subtle/60 font-mono text-[11px] uppercase text-ink-muted">
              <th class="py-2.5 px-4 font-semibold">State</th>
              <th class="py-2.5 px-4 font-semibold">Typical Cost</th>
              <th class="py-2.5 px-4 font-semibold">Low – High Range</th>
              <th class="py-2.5 px-4 font-semibold">RPP Index</th>
              <th class="py-2.5 px-4 font-semibold text-right">vs. US Avg</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline">
            <tr class="bg-lime-500/15 font-semibold">
              <td class="py-2.5 px-4 text-ink">{state.name} (Selected)</td>
              <td class="py-2.5 px-4 font-mono font-bold text-ink">${estimate.typical.toLocaleString()}</td>
              <td class="py-2.5 px-4 font-mono">${estimate.low.toLocaleString()} – ${estimate.high.toLocaleString()}</td>
              <td class="py-2.5 px-4 font-mono">{state.rpp}%</td>
              <td class="py-2.5 px-4 font-mono text-right">{estimate.percentDiffVsNational > 0 ? '+' : ''}{estimate.percentDiffVsNational}%</td>
            </tr>
            {neighborStates.map((ns) => {
              const nEst = calculateStateJobCost(job, ns);
              return (
                <tr class="hover:bg-surface-subtle/40 transition-colors">
                  <td class="py-2.5 px-4 font-medium">
                    <a href={`/cost/${job.slug}/${ns.slug}/`} class="text-blueprint hover:underline">
                      {ns.name} <span class="font-mono text-[11px] text-ink-muted">({ns.abbr})</span>
                    </a>
                  </td>
                  <td class="py-2.5 px-4 font-mono font-semibold text-ink">${nEst.typical.toLocaleString()}</td>
                  <td class="py-2.5 px-4 font-mono text-ink-muted">${nEst.low.toLocaleString()} – ${nEst.high.toLocaleString()}</td>
                  <td class="py-2.5 px-4 font-mono text-ink-muted">{ns.rpp}%</td>
                  <td class="py-2.5 px-4 font-mono text-right text-ink-muted">{nEst.percentDiffVsNational > 0 ? '+' : ''}{nEst.percentDiffVsNational}%</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Ways to Save -->
  <section class="bm-panel p-5 sm:p-6 my-8" aria-labelledby="ways-to-save-heading">
    <h2 id="ways-to-save-heading" class="text-lg sm:text-xl font-bold text-ink mb-4">
      Ways to Optimize Costs on {job.name} in {state.name}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm text-ink-body leading-relaxed">
      <div class="p-4 rounded-lg bg-canvas border border-hairline">
        <span class="font-mono text-[11px] font-semibold text-blueprint">01 // MATERIAL CONTROL</span>
        <h3 class="font-bold text-ink mt-1 mb-1.5">
          Calculate Exact Material Quantities First
        </h3>
        <p>
          {job.diySavingsNote} Use our{' '}
          <a href={`/calculators/${job.relatedCalculatorSlug}/`} class="text-blueprint font-semibold underline">
            {job.name} Material Calculator
          </a>{' '}
          to audit contractor bill-of-materials takeoff quantities before signing.
        </p>
      </div>
      <div class="p-4 rounded-lg bg-canvas border border-hairline">
        <span class="font-mono text-[11px] font-semibold text-blueprint">02 // SCHEDULING WINDOW</span>
        <h3 class="font-bold text-ink mt-1 mb-1.5">
          Book Off-Peak Labor ({job.bestSeason})
        </h3>
        <p class="tabular-nums">
          With labor in {state.name} averaging ${estimate.laborCost.toLocaleString()} ({Math.round(job.laborShare * 100)}%), scheduling during {job.bestSeason.toLowerCase()} and handling basic site prep reduces billable crew hours.
        </p>
      </div>
    </div>
  </section>

  <LeadGenWidget jobTitle={job.name} stateName={state.name} />

  <FAQSection
    faqs={faqs}
    title={`${job.name} in ${state.name}: Frequently Asked Questions`}
  />

  <footer class="bm-panel p-5 mt-8 bg-surface-subtle/50 text-xs text-ink-muted space-y-2">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <strong class="text-ink font-semibold">
        {job.verified ? `Verified Bottom-Up Cost Sources (${state.name})` : `Model Data Sources (${state.name})`}
      </strong>
      {job.verified && job.lastReviewed && (
        <span class="font-mono">Last Reviewed: <strong class="text-ink">{job.lastReviewed}</strong></span>
      )}
    </div>
    <ul class="list-disc pl-5 space-y-1 leading-relaxed">
      {job.sources.map((src) => (
        <li>{src}</li>
      ))}
    </ul>
  </footer>
</CostLayout>
