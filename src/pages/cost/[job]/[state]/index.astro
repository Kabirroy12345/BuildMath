---
import CostLayout from '../../../../layouts/CostLayout.astro';
import StateCostEstimator from '../../../../components/StateCostEstimator';
import LeadGenWidget from '../../../../components/LeadGenWidget.astro';
import FAQSection from '../../../../components/FAQSection.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import { calculateStateJobCost } from '../../../../lib/formulas/state-cost';
import { shouldIndexCostPage } from '../../../../config/seo';
import { siteConfig } from '../../../../config/site';
import jobs from '../../../../data/costs/jobs.json';
import states from '../../../../data/costs/states.json';

export function getStaticPaths() {
  const paths = [];
  for (const job of jobs) {
    for (const state of states) {
      paths.push({
        params: { job: job.slug, state: state.slug },
        props: { job, state },
      });
    }
  }
  return paths;
}

const { job, state } = Astro.props;
const estimate = calculateStateJobCost(job as any, state as any);
const shouldIndex = shouldIndexCostPage(job.verified, state.slug);

const diffWord =
  estimate.percentDiffVsNational > 0
    ? `${estimate.percentDiffVsNational}% above`
    : estimate.percentDiffVsNational < 0
      ? `${Math.abs(estimate.percentDiffVsNational)}% below`
      : 'equal to';

const tradeHourlyWage = estimate.stateTradeWage;

const neighborStates = (state.neighbors || [])
  .map((slug: string) => states.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const currentYear = new Date().getFullYear();

const faqs = [
  {
    question: `How much does ${job.name.toLowerCase()} cost in ${state.name} in ${currentYear}?`,
    answer: `In ${state.name}, ${job.name.toLowerCase()} costs an average of $${estimate.typical.toLocaleString()} for a typical ${job.typicalProjectSize.toLocaleString()} ${job.unit} project, with most homeowners paying between $${estimate.low.toLocaleString()} and $${estimate.high.toLocaleString()} ($${estimate.lowPerUnit} to $${estimate.highPerUnit} per ${job.unit}). This is ${diffWord} the US national average of $${estimate.nationalTotalTypical.toLocaleString()}.`,
  },
  {
    question: `What is the average labor rate for ${job.tradeName.toLowerCase()} in ${state.name}?`,
    answer: `According to Bureau of Labor Statistics (BLS OEWS, SOC ${job.socCode}) data for ${state.name}, the mean base hourly wage for ${job.tradeName.toLowerCase()} is $${tradeHourlyWage.toFixed(2)}/hr. Once contractor overhead, workers' compensation, liability insurance, and profit are included, billed residential labor rates in ${state.name} typically run $${Math.round(tradeHourlyWage * 2.1)} to $${Math.round(tradeHourlyWage * 2.75)} per hour.`,
  },
  {
    question: `Do I need a permit or licensed contractor for ${job.name.toLowerCase()} in ${state.name}?`,
    answer: `${state.permitNote} Always verify contractor credentials directly with the ${state.licensingBoardName}.`,
  },
  {
    question: `How do ${state.name} climate conditions affect ${job.name.toLowerCase()}?`,
    answer: `${state.name} is located in ${state.climateZone}. ${state.climateConsiderations}`,
  },
];
---

<CostLayout
  title={`Cost of ${job.name} in ${state.name} (${currentYear} Local Price Guide)`}
  metaTitle={`${job.name} Cost in ${state.name}: $${estimate.low.toLocaleString()}–$${estimate.high.toLocaleString()}`}
  metaDescription={`How much does ${job.name.toLowerCase()} cost in ${state.name}? Typical price is $${estimate.typical.toLocaleString()} ($${estimate.lowPerUnit}–$${estimate.highPerUnit}/${job.unit}), ${diffWord} the US average.`}
  pathname={`/cost/${job.slug}/${state.slug}/`}
  noindex={!shouldIndex}
  lastUpdated={job.lastReviewed || siteConfig.lastUpdatedDefault}
  breadcrumbs={[
    { name: 'Cost Guides', href: '/cost/' },
    { name: job.name, href: `/cost/${job.slug}/` },
    { name: state.name, href: `/cost/${job.slug}/${state.slug}/` },
  ]}
>
  <!-- 1. H1: Cost to [Job] in [State] (Year) -->
  <header class="mb-5">
    <span class="inline-block text-xs font-bold uppercase tracking-wider text-brand-700 dark:text-brand-300 bg-brand-100 dark:bg-brand-950 px-2.5 py-1 rounded-md mb-2">
      {state.name} ({state.abbr}) Regional Cost Guide
    </span>
    <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      Cost of {job.name} in {state.name} ({currentYear})
    </h1>
  </header>

  <!-- 2. Answer box above the fold -->
  <section
    aria-label="Quick cost summary"
    class="card p-5 sm:p-6 bg-gradient-to-br from-brand-50/80 to-white dark:from-slate-900 dark:to-slate-900 border-brand-200 dark:border-brand-900 mb-6"
  >
    <p class="text-sm sm:text-base text-slate-800 dark:text-slate-200 leading-relaxed mb-4">
      In <strong>{state.name}</strong>, the typical cost for <strong>{job.name.toLowerCase()}</strong> is{' '}
      <strong class="text-brand-700 dark:text-brand-300">${estimate.typical.toLocaleString()}</strong> for a standard{' '}
      {job.typicalProjectSize.toLocaleString()} {job.unit} project, with most homeowners spending between{' '}
      <strong>${estimate.low.toLocaleString()} and ${estimate.high.toLocaleString()}</strong> (${estimate.lowPerUnit} – ${estimate.highPerUnit} per {job.unit}). Overall project pricing in {state.name} runs{' '}
      <strong>{diffWord}</strong> the US national average of ${estimate.nationalTotalTypical.toLocaleString()}.
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
      <div class="p-3.5 rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
        <span class="text-[11px] uppercase tracking-wider text-slate-500 block">Typical {state.abbr} Cost</span>
        <strong class="text-xl sm:text-2xl font-extrabold text-brand-700 dark:text-brand-400">
          ${estimate.typical.toLocaleString()}
        </strong>
      </div>
      <div class="p-3.5 rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
        <span class="text-[11px] uppercase tracking-wider text-slate-500 block">Low – High Range</span>
        <strong class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
          ${estimate.low.toLocaleString()} – ${estimate.high.toLocaleString()}
        </strong>
      </div>
      <div class="p-3.5 rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
        <span class="text-[11px] uppercase tracking-wider text-slate-500 block">Per {job.unit}</span>
        <strong class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
          ${estimate.lowPerUnit} – ${estimate.highPerUnit}
        </strong>
      </div>
      <div class="p-3.5 rounded-xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
        <span class="text-[11px] uppercase tracking-wider text-slate-500 block">vs. National Avg</span>
        <strong class={`text-base sm:text-lg font-bold ${estimate.percentDiffVsNational > 0 ? 'text-amber-700 dark:text-amber-400' : 'text-emerald-700 dark:text-emerald-400'}`}>
          {estimate.percentDiffVsNational > 0 ? '+' : ''}{estimate.percentDiffVsNational}%
        </strong>
      </div>
    </div>
  </section>

  <!-- 3. Interactive mini-estimator pre-filled with state multiplier -->
  <StateCostEstimator
    client:load
    job={job}
    state={state}
    relatedCalculatorSlug={job.relatedCalculatorSlug}
  />

  <AdSlot position="belowCalculator" />

  <!-- 4. Cost breakdown table: materials vs labor, low / typical / high -->
  <section class="card p-6 my-8" aria-labelledby="breakdown-heading">
    <h2 id="breakdown-heading" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-2">
      {state.name} {job.name}: Materials vs. Labor Breakdown
    </h2>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mb-4">
      Itemized estimate for a {job.typicalProjectSize.toLocaleString()} {job.unit} project in {state.name} (labor index: {(estimate.laborMultiplier * 100).toFixed(0)}%, material RPP index: {state.rpp}%):
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead>
          <tr class="border-b-2 border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60">
            <th class="py-3 px-4 font-bold">Expense Category</th>
            <th class="py-3 px-4 font-bold">Share of Total</th>
            <th class="py-3 px-4 font-bold">Low Range ({state.abbr})</th>
            <th class="py-3 px-4 font-bold">Typical ({state.abbr})</th>
            <th class="py-3 px-4 font-bold">High Range ({state.abbr})</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
          <tr>
            <td class="py-3 px-4 font-semibold text-slate-900 dark:text-white">
              Contractor Labor ({job.tradeName})
            </td>
            <td class="py-3 px-4">{Math.round(job.laborShare * 100)}%</td>
            <td class="py-3 px-4">${Math.round(estimate.low * job.laborShare).toLocaleString()}</td>
            <td class="py-3 px-4 font-bold">${estimate.laborCost.toLocaleString()}</td>
            <td class="py-3 px-4">${Math.round(estimate.high * job.laborShare).toLocaleString()}</td>
          </tr>
          {job.materialsBreakdown.map((m) => {
            const matShare = (1 - job.laborShare) * (m.sharePercent / 100);
            return (
              <tr>
                <td class="py-3 px-4 text-slate-700 dark:text-slate-300">{m.item}</td>
                <td class="py-3 px-4">{Math.round(matShare * 100)}%</td>
                <td class="py-3 px-4">${Math.round(estimate.low * matShare).toLocaleString()}</td>
                <td class="py-3 px-4 font-semibold">${Math.round(estimate.materialCost * (m.sharePercent / 100)).toLocaleString()}</td>
                <td class="py-3 px-4">${Math.round(estimate.high * matShare).toLocaleString()}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 5. State-specific factors: BLS wage data, climate/frost-line notes, permit & licensing board URL -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-5 my-8" aria-labelledby="state-factors-heading">
    <h2 id="state-factors-heading" class="sr-only">
      {state.name}-Specific Labor, Climate, and Licensing Factors
    </h2>

    <div class="card p-5">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-700 dark:text-brand-300">
        1. Local Trade Wages (BLS)
      </span>
      <h3 class="text-base font-bold text-slate-900 dark:text-white mt-1">
        {job.tradeName} in {state.name}
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
        Per Bureau of Labor Statistics (SOC {job.socCode}), the mean hourly wage for {job.tradeName.toLowerCase()} in {state.name} is <strong>${tradeHourlyWage.toFixed(2)}/hr</strong> (vs. ${job.nationalTradeWage.toFixed(2)}/hr nationally). Including workers' comp, insurance, and overhead, expect contractor billing rates of <strong>${Math.round(tradeHourlyWage * 2.1)}–${Math.round(tradeHourlyWage * 2.75)}/hr</strong>.
      </p>
    </div>

    <div class="card p-5">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-700 dark:text-brand-300">
        2. Climate & Code Specs
      </span>
      <h3 class="text-base font-bold text-slate-900 dark:text-white mt-1">
        {state.climateZone}
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
        {state.climateConsiderations}
      </p>
    </div>

    <div class="card p-5">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-700 dark:text-brand-300">
        3. Permits & Contractor Licensing
      </span>
      <h3 class="text-base font-bold text-slate-900 dark:text-white mt-1">
        {state.licensingBoardName}
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
        {state.permitNote}
      </p>
      <a
        href={state.licensingBoardUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline"
      >
        Verify a {state.name} Contractor License ↗
      </a>
    </div>
  </section>

  <!-- 6. Neighboring states comparison table -->
  {neighborStates.length > 0 && (
    <section class="card p-6 my-8" aria-labelledby="neighbors-heading">
      <h2 id="neighbors-heading" class="text-xl font-bold text-slate-900 dark:text-white mb-2">
        How {state.name} Compares to Neighboring States
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mb-4">
        Regional comparison for a {job.typicalProjectSize.toLocaleString()} {job.unit} {job.name.toLowerCase()} project:
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="border-b-2 border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60">
              <th class="py-2.5 px-4 font-bold">State</th>
              <th class="py-2.5 px-4 font-bold">Typical Cost</th>
              <th class="py-2.5 px-4 font-bold">Low – High Range</th>
              <th class="py-2.5 px-4 font-bold">RPP Index</th>
              <th class="py-2.5 px-4 font-bold">vs. US Avg</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
            <tr class="bg-brand-50/50 dark:bg-brand-950/30 font-semibold">
              <td class="py-2.5 px-4">{state.name} (Current)</td>
              <td class="py-2.5 px-4 text-brand-700 dark:text-brand-300">${estimate.typical.toLocaleString()}</td>
              <td class="py-2.5 px-4">${estimate.low.toLocaleString()} – ${estimate.high.toLocaleString()}</td>
              <td class="py-2.5 px-4">{state.rpp}%</td>
              <td class="py-2.5 px-4">{estimate.percentDiffVsNational > 0 ? '+' : ''}{estimate.percentDiffVsNational}%</td>
            </tr>
            {neighborStates.map((ns) => {
              const nEst = calculateStateJobCost(job, ns);
              return (
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-900/50">
                  <td class="py-2.5 px-4 font-medium">
                    <a href={`/cost/${job.slug}/${ns.slug}/`} class="text-brand-600 dark:text-brand-400 hover:underline">
                      {ns.name} ({ns.abbr})
                    </a>
                  </td>
                  <td class="py-2.5 px-4 font-semibold">${nEst.typical.toLocaleString()}</td>
                  <td class="py-2.5 px-4">${nEst.low.toLocaleString()} – ${nEst.high.toLocaleString()}</td>
                  <td class="py-2.5 px-4">{ns.rpp}%</td>
                  <td class="py-2.5 px-4">{nEst.percentDiffVsNational > 0 ? '+' : ''}{nEst.percentDiffVsNational}%</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- 7. Ways to save (DIY vs hiring a pro, linking back to the DIY calculator) -->
  <section class="card p-6 my-8" aria-labelledby="ways-to-save-heading">
    <h2 id="ways-to-save-heading" class="text-xl font-bold text-slate-900 dark:text-white mb-3">
      Ways to Save on {job.name} in {state.name} (DIY vs. Hiring a Pro)
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-700 dark:text-slate-300">
      <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
        <h3 class="font-bold text-slate-900 dark:text-white mb-1">
          1. Calculate & Buy Your Own Materials
        </h3>
        <p class="text-xs sm:text-sm">
          {job.diySavingsNote} Use our free{' '}
          <a href={`/calculators/${job.relatedCalculatorSlug}/`} class="text-brand-600 dark:text-brand-400 font-semibold underline">
            {job.name} Material Calculator
          </a>{' '}
          to verify exact quantities so you never pay for padded material estimates.
        </p>
      </div>
      <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
        <h3 class="font-bold text-slate-900 dark:text-white mb-1">
          2. Schedule in the Off-Peak Season ({job.bestSeason})
        </h3>
        <p class="text-xs sm:text-sm">
          With professional labor in {state.name} accounting for ${estimate.laborCost.toLocaleString()} ({Math.round(job.laborShare * 100)}%) of a typical project, booking during {job.bestSeason.toLowerCase()} and handling site prep yourself significantly reduces billed crew hours.
        </p>
      </div>
    </div>
  </section>

  <!-- 8. Lead-gen placeholder block (feature-flagged) -->
  <LeadGenWidget jobTitle={job.name} stateName={state.name} />

  <!-- 9. FAQ (4-6 data-driven questions) -->
  <FAQSection
    faqs={faqs}
    title={`${job.name} in ${state.name}: Frequently Asked Questions`}
  />
</CostLayout>
