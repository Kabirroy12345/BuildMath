---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox, { type SearchableItem } from '../components/SearchBox';
import RecentCalculators from '../components/RecentCalculators';
import Icon from '../components/Icon.astro';
import { getCategoryIconName } from '../lib/lucide-icons';
import { CALCULATOR_CATALOG_META } from '../lib/calculator-catalog';
import { SCHEMATIC_PATHS } from '../lib/schematics';
import { siteConfig } from '../config/site';
import categories from '../data/categories.json';
import calculators from '../data/calculators.json';
import jobs from '../data/costs/jobs.json';
import states from '../data/costs/states.json';
import guides from '../data/guides.json';

const categoryMap = Object.fromEntries(categories.map((c) => [c.slug, c.name]));

const searchItems: SearchableItem[] = [
  ...calculators.map((calc) => {
    const meta = CALCULATOR_CATALOG_META[calc.slug];
    return {
      slug: calc.slug,
      title: calc.name,
      shortTitle: calc.shortName,
      category: calc.category,
      categoryName: categoryMap[calc.category] || calc.category,
      description: meta?.summaryDesc || calc.intro,
      inputsLabel: meta?.inputsLabel,
      outputsLabel: meta?.outputsLabel,
      popularityRank: meta?.popularityRank ?? 99,
      href: `/calculators/${calc.slug}/`,
      type: 'calculator' as const,
    };
  }),
  ...jobs.map((job) => ({
    slug: job.slug,
    title: `${job.name} Cost Guide`,
    shortTitle: job.name,
    category: 'cost',
    categoryName: 'Cost Guide',
    description: `Typical national cost: $${Math.round(job.nationalTypicalPerUnit * job.typicalProjectSize).toLocaleString()} ($${job.nationalLowPerUnit}–$${job.nationalHighPerUnit}/${job.unit}).`,
    href: `/cost/${job.slug}/`,
    type: 'cost' as const,
  })),
];

const popularSlugs = [
  'paint-calculator',
  'concrete-slab-calculator',
  'roofing-calculator',
  'flooring-calculator',
  'mulch-calculator',
  'fence-calculator',
  'deck-calculator',
  'tile-calculator',
  'drywall-calculator',
  'gravel-calculator',
  'stair-calculator',
  'square-footage-calculator',
];

const popularCalculators = popularSlugs
  .map((s) => calculators.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const featuredJobs = jobs.slice(0, 8);
const topStates = states.slice(0, 12);
---

<BaseLayout
  title="BuildMath: Free DIY & Home Improvement Calculators + Cost Guides"
  description="Get accurate DIY material quantities and local project cost estimates in under 10 seconds. 32 source-cited home improvement calculators for US homeowners."
  pathname="/"
>
  <!-- Architectural Engineering Hero Section -->
  <section class="relative overflow-hidden rounded-2xl border border-hairline bg-surface bm-cad-grid px-5 sm:px-10 py-10 sm:py-14 mb-12">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-graphite-900 text-[#F8F8F5] font-mono text-[10px] sm:text-[11px] font-semibold tracking-wider uppercase mb-5">
        <span class="h-1.5 w-1.5 rounded-full bg-lime-500 shrink-0"></span>
        <span>32 Calculators // 50 States + DC</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-[54px] font-extrabold tracking-tight text-ink leading-[1.08]">
        Accurate Home-Improvement Math in Under 10 Seconds
      </h1>

      <p class="mt-4 text-sm sm:text-lg text-ink-body max-w-2xl mx-auto leading-relaxed">
        Compute exact purchasable bags, gallons, bundles, sheets, and cubic yards alongside localized US labor and material cost models.
      </p>

      <div class="mt-8">
        <SearchBox client:load items={searchItems} />
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-center gap-2 text-xs">
        <span class="font-mono text-[11px] uppercase tracking-wider text-ink-muted mr-1">Quick Open:</span>
        <a href="/calculators/paint-calculator/" class="px-2.5 py-1 rounded-md bg-canvas border border-hairline hover:border-blueprint text-ink font-medium transition-colors">
          Paint
        </a>
        <a href="/calculators/concrete-slab-calculator/" class="px-2.5 py-1 rounded-md bg-canvas border border-hairline hover:border-blueprint text-ink font-medium transition-colors">
          Concrete Slab
        </a>
        <a href="/calculators/mulch-calculator/" class="px-2.5 py-1 rounded-md bg-canvas border border-hairline hover:border-blueprint text-ink font-medium transition-colors">
          Mulch
        </a>
        <a href="/calculators/roofing-calculator/" class="px-2.5 py-1 rounded-md bg-canvas border border-hairline hover:border-blueprint text-ink font-medium transition-colors">
          Roofing Shingles
        </a>
        <a href="/calculators/stair-calculator/" class="px-2.5 py-1 rounded-md bg-canvas border border-hairline hover:border-blueprint text-ink font-medium transition-colors">
          Stair Stringers
        </a>
      </div>
    </div>

    <!-- Compact Instrument Telemetry Spec Strip -->
    <div class="mt-10 max-w-5xl mx-auto rounded-xl bg-graphite-700 p-px grid grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden border border-graphite-700">
      <div class="bg-graphite-900 text-[#F8F8F5] p-4 flex flex-col justify-between">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#8E949D]">Rounding Behavior</span>
        <div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <span class="font-mono text-sm sm:text-base font-bold text-lime-500">Store Units</span>
          <span class="text-[11px] sm:text-xs text-[#9BA1AA]">+ exact math</span>
        </div>
      </div>
      <div class="bg-graphite-900 text-[#F8F8F5] p-4 flex flex-col justify-between">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#8E949D]">Codes &amp; Specs</span>
        <div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <span class="font-mono text-sm sm:text-base font-bold text-[#F8F8F5]">ACI · ARMA</span>
          <span class="text-[11px] sm:text-xs text-[#6FA3D2]">2024 IRC</span>
        </div>
      </div>
      <div class="bg-graphite-900 text-[#F8F8F5] p-4 flex flex-col justify-between">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#8E949D]">Unit Support</span>
        <div class="mt-1 flex items-baseline gap-2">
          <span class="font-mono text-sm sm:text-base font-bold text-[#F8F8F5]">ft/in ⇄ m/cm</span>
        </div>
      </div>
      <div class="bg-graphite-900 text-[#F8F8F5] p-4 flex flex-col justify-between">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#8E949D]">Verification</span>
        <div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <span class="font-mono text-sm sm:text-base font-bold text-lime-500 tabular-nums">100 / 100</span>
          <span class="text-[11px] sm:text-xs text-[#9BA1AA]">unit tests</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Recently Used Calculators (Progressive Enhancement via localStorage) -->
  <RecentCalculators client:idle />

  <!-- Featured Calculator Categories (8 Trades) -->
  <section class="mb-14" aria-labelledby="categories-heading">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <span class="bm-eyebrow-blue mb-2">Trade Directory // 08 Categories</span>
        <h2 id="categories-heading" class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
          Browse Calculators by Trade
        </h2>
        <p class="text-sm text-ink-muted mt-1">
          32 specialized engineering instruments organized across 8 residential trades.
        </p>
      </div>
      <a href="/calculators/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-blueprint hover:underline shrink-0">
        <span>View all 32 calculators</span>
        <Icon name="arrow-right" size={15} />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {categories.map((cat) => {
        const catCalcs = calculators.filter((c) => c.category === cat.slug);
        return (
          <div class="bm-panel bm-panel-hover p-5 flex flex-col justify-between hover:border-blueprint/70">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface-subtle border border-hairline text-blueprint">
                  <Icon name={getCategoryIconName(cat.slug)} size={18} />
                </span>
                <span class="font-mono text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded bg-surface-subtle text-ink-muted border border-hairline tabular-nums">
                  {String(catCalcs.length).padStart(2, '0')} TOOLS
                </span>
              </div>

              <a href={`/calculators/${cat.slug}/`} class="group">
                <h3 class="text-base font-bold text-ink group-hover:text-blueprint transition-colors">
                  {cat.name}
                </h3>
              </a>
              <p class="text-xs text-ink-muted mt-1.5 mb-3.5 leading-relaxed line-clamp-2">
                {cat.description}
              </p>

              <ul class="space-y-1.5 text-xs border-t border-hairline pt-3">
                {catCalcs.map((c) => (
                  <li>
                    <a
                      href={`/calculators/${c.slug}/`}
                      class="inline-flex items-center gap-1.5 text-ink-body hover:text-blueprint transition-colors"
                    >
                      <span class="h-1 w-1 rounded-full bg-hairline-strong"></span>
                      <span>{c.shortName}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={`/calculators/${cat.slug}/`}
              class="mt-4 pt-3 border-t border-hairline inline-flex items-center justify-between text-xs font-semibold text-blueprint hover:underline"
            >
              <span>Explore {cat.shortName}</span>
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 12 Popular Calculators -->
  <section class="mb-14" aria-labelledby="popular-calcs-heading">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <span class="bm-eyebrow mb-2">Most Used // Quick Access</span>
        <h2 id="popular-calcs-heading" class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
          12 Essential Construction Calculators
        </h2>
        <p class="text-sm text-ink-muted mt-1">
          Live material takeoffs, waste sliders, and store-unit shopping lists.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {popularCalculators.map((calc) => {
        const meta = CALCULATOR_CATALOG_META[calc.slug];
        const sch = meta?.schematic ? SCHEMATIC_PATHS[meta.schematic] : null;
        return (
          <a
            href={`/calculators/${calc.slug}/`}
            class="bm-panel bm-panel-hover p-5 group flex flex-col justify-between hover:border-blueprint/75"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="inline-flex items-center gap-1.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-blueprint bg-blueprint-soft px-2 py-0.5 rounded">
                  <Icon name={getCategoryIconName(calc.category)} size={12} />
                  {categoryMap[calc.category]}
                </span>
                {sch ? (
                  <svg viewBox="0 0 32 22" width="32" height="22" aria-hidden="true" class="text-blueprint opacity-75 group-hover:opacity-100 shrink-0" set:html={sch} />
                ) : (
                  <Icon name="arrow-up-right" size={15} class="text-ink-muted group-hover:text-ink transition-colors" />
                )}
              </div>
              <h3 class="text-base font-bold text-ink group-hover:text-blueprint transition-colors">
                {calc.name}
              </h3>
              <p class="mt-1 text-xs sm:text-[13px] text-ink-muted line-clamp-2 leading-snug">
                {meta?.summaryDesc || calc.intro}
              </p>
              {meta && (
                <dl class="mt-3 pt-2.5 border-t border-hairline space-y-1 text-[11px]">
                  <div class="flex items-baseline gap-2">
                    <dt class="font-mono font-semibold uppercase text-ink-muted w-14 shrink-0">Inputs:</dt>
                    <dd class="text-ink-body truncate">{meta.inputsLabel}</dd>
                  </div>
                  <div class="flex items-baseline gap-2">
                    <dt class="font-mono font-semibold uppercase text-ink-muted w-14 shrink-0">Outputs:</dt>
                    <dd class="text-ink font-medium truncate">{meta.outputsLabel}</dd>
                  </div>
                </dl>
              )}
            </div>
            <div class="mt-4 pt-3 border-t border-hairline flex items-center justify-between text-xs font-semibold text-ink">
              <span>Open Calculator</span>
              <Icon name="arrow-right" size={14} class="text-blueprint group-hover:translate-x-0.5 transition-transform" />
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- How BuildMath Works & Engineering Rigor -->
  <section class="mb-14 bm-panel overflow-hidden" aria-labelledby="how-buildmath-works">
    <div class="px-6 py-5 border-b border-hairline bg-surface-subtle/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <span class="bm-eyebrow-blue mb-1.5">System Architecture</span>
        <h2 id="how-buildmath-works" class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
          How BuildMath Computes Store-Ready Takeoffs
        </h2>
      </div>
      <a href="/methodology/" class="bm-btn-secondary text-xs shrink-0">
        Read Full Methodology
        <Icon name="arrow-right" size={14} />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-hairline">
      <div class="p-6 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs font-bold text-blueprint">01 // CALIBRATED INPUTS</span>
          <Icon name="sliders-horizontal" size={17} class="text-ink-muted" />
        </div>
        <h3 class="text-base font-bold text-ink">Published Manufacturer Specs</h3>
        <p class="text-xs sm:text-sm text-ink-muted leading-relaxed">
          Every coverage rate, bag yield, and slope factor cites standards (ACI 318, ARMA, NWFA, USG Handbook, 2024 IRC) and can be edited to match your product label.
        </p>
      </div>

      <div class="p-6 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs font-bold text-blueprint">02 // UNIT ROUNDING</span>
          <Icon name="calculator" size={17} class="text-ink-muted" />
        </div>
        <h3 class="text-base font-bold text-ink">Exact Math + Purchasable Quantities</h3>
        <p class="text-xs sm:text-sm text-ink-muted leading-relaxed">
          Hardware stores don't sell 2.37 bags of concrete or 1.4 bundles of shingles. Readout displays both the unrounded calculation and the store-ready unit count.
        </p>
      </div>

      <div class="p-6 space-y-2.5">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs font-bold text-blueprint">03 // LOCALIZED BOM</span>
          <Icon name="clipboard-list" size={17} class="text-ink-muted" />
        </div>
        <h3 class="text-base font-bold text-ink">Private Browser Project List</h3>
        <p class="text-xs sm:text-sm text-ink-muted leading-relaxed">
          Combine multiple room calculations into your <a href="/my-project/" class="text-blueprint font-semibold underline">My Project Shopping List</a>, print clean worksheets, or share permalink parameters without creating an account.
        </p>
      </div>
    </div>
  </section>

  <!-- Home Improvement Cost Guides by State -->
  <section class="mb-14" aria-labelledby="cost-guides-heading">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <span class="bm-eyebrow mb-2">Labor &amp; Material Benchmarks</span>
        <h2 id="cost-guides-heading" class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
          Home Improvement Cost Guides by State
        </h2>
        <p class="text-sm text-ink-muted mt-1">
          Localized installation models built on BLS occupational wages and BEA Regional Price Parities across all 50 US states and DC.
        </p>
      </div>
      <a href="/cost/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-blueprint hover:underline shrink-0">
        <span>All 25 Cost Guides</span>
        <Icon name="arrow-right" size={15} />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      {featuredJobs.map((job) => (
        <a
          href={`/cost/${job.slug}/`}
          class="bm-panel bm-panel-hover p-4 flex flex-col justify-between group hover:border-blueprint/70"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="font-mono text-[10px] text-ink-muted uppercase">
                {job.typicalProjectSize.toLocaleString()} {job.unit}
              </span>
              {job.verified && (
                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-lime-500/20 text-ink dark:text-lime-500 border border-lime-500/40 font-mono text-[10px] font-semibold">
                  <span class="h-1.5 w-1.5 rounded-full bg-lime-500"></span>
                  Verified
                </span>
              )}
            </div>
            <h3 class="text-sm font-bold text-ink group-hover:text-blueprint transition-colors">
              Cost of {job.name}
            </h3>
            <p class="text-xs text-ink-muted mt-1 tabular-nums">
              US Typical:{' '}
              <strong class="text-ink font-semibold">
                ${Math.round(job.nationalTypicalPerUnit * job.typicalProjectSize).toLocaleString()}
              </strong>
            </p>
          </div>
          <div class="mt-3 pt-2.5 border-t border-hairline flex items-center justify-between text-xs font-semibold text-blueprint">
            <span>State Breakdown</span>
            <Icon name="arrow-right" size={13} />
          </div>
        </a>
      ))}
    </div>

    <div class="bm-panel p-5 bg-surface-subtle/50">
      <div class="flex items-center justify-between gap-2 mb-3">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-ink">
          Quick Jump // Verified Roof Replacement Cost by State
        </h3>
        <Icon name="map-pin" size={15} class="text-blueprint" />
      </div>
      <div class="flex flex-wrap gap-2">
        {topStates.map((st) => (
          <a
            href={`/cost/roof-replacement/${st.slug}/`}
            class="px-3 py-1.5 rounded-md text-xs font-medium bg-surface border border-hairline hover:border-blueprint text-ink transition-colors"
          >
            {st.name} <span class="font-mono text-ink-muted">({st.abbr})</span>
          </a>
        ))}
        <a
          href="/cost/roof-replacement/"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-md text-xs font-semibold text-blueprint hover:underline"
        >
          <span>All 50 States + DC</span>
          <Icon name="arrow-right" size={13} />
        </a>
      </div>
    </div>
  </section>

  <!-- Step-by-Step Measurement Field Guides -->
  <section aria-labelledby="guides-heading">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <span class="bm-eyebrow mb-2">Field Procedures</span>
        <h2 id="guides-heading" class="text-2xl font-extrabold text-ink tracking-tight">
          Measurement &amp; Estimation Guides
        </h2>
        <p class="text-sm text-ink-muted mt-1">
          Practical field procedures compiled by {siteConfig.author.name}.
        </p>
      </div>
      <a href="/guides/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-blueprint hover:underline shrink-0">
        <span>All Guides</span>
        <Icon name="arrow-right" size={15} />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {guides.slice(0, 3).map((g) => (
        <a href={`/guides/${g.slug}/`} class="bm-panel bm-panel-hover p-5 flex flex-col justify-between group hover:border-blueprint/70">
          <div>
            <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-ink-muted mb-2">
              <Icon name="clock" size={12} />
              {g.readingTime}
            </span>
            <h3 class="text-base font-bold text-ink group-hover:text-blueprint transition-colors">
              {g.title}
            </h3>
            <p class="mt-2 text-xs sm:text-sm text-ink-muted line-clamp-2 leading-relaxed">
              {g.excerpt}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-hairline flex items-center justify-between text-xs font-semibold text-blueprint">
            <span>Read Field Guide</span>
            <Icon name="arrow-right" size={14} />
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
