---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox, { type SearchableItem } from '../components/SearchBox';
import RecentCalculators from '../components/RecentCalculators';
import WorkspaceShowcase from '../components/WorkspaceShowcase';
import HeroSpecimenConsole, { type HeroSpecimenItem } from '../components/HeroSpecimenConsole';
import Icon from '../components/Icon.astro';
import { getCategoryIconName } from '../lib/lucide-icons';
import { CALCULATOR_CATALOG_META } from '../lib/calculator-catalog';
import { SCHEMATIC_PATHS } from '../lib/schematics';
import { runCalculatorFormula } from '../lib/formulas/index';
import { siteConfig } from '../config/site';
import categories from '../data/categories.json';
import calculators from '../data/calculators.json';
import jobs from '../data/costs/jobs.json';
import states from '../data/costs/states.json';
import guides from '../data/guides.json';

const categoryMap = Object.fromEntries(categories.map((c) => [c.slug, c.name]));

const tradeStandards: Record<string, string> = {
  painting: 'MPI & ASTM Coverage Specs',
  flooring: 'NWFA / TCNA Mortar Specs',
  'concrete-masonry': 'ACI 318 / Quikrete / BIA',
  roofing: 'ARMA / NRCA Pitch Geometry',
  landscaping: 'Bulk Volume & Stone Density',
  'fencing-decking': 'AWC DCA6 & 811 Clearances',
  'drywall-walls': 'USG Handbook & 2024 IRC',
  'general-conversions': 'Multi-Shape Planimetric Math',
};

const searchItems: SearchableItem[] = [
  ...calculators.map((calc) => {
    const meta = CALCULATOR_CATALOG_META[calc.slug];
    return {
      slug: calc.slug,
      title: calc.name,
      shortTitle: calc.shortName,
      category: calc.category,
      categoryName: categoryMap[calc.category] || calc.category,
      description: meta?.summaryDesc || calc.intro,
      inputsLabel: meta?.inputsLabel,
      outputsLabel: meta?.outputsLabel,
      popularityRank: meta?.popularityRank ?? 99,
      href: `/calculators/${calc.slug}/`,
      type: 'calculator' as const,
    };
  }),
  ...jobs.map((job) => ({
    slug: job.slug,
    title: `${job.name} Cost Guide`,
    shortTitle: job.name,
    category: 'cost',
    categoryName: 'Cost Guide',
    description: `Typical national cost: $${Math.round(job.nationalTypicalPerUnit * job.typicalProjectSize).toLocaleString()} ($${job.nationalLowPerUnit}–$${job.nationalHighPerUnit}/${job.unit}).`,
    href: `/cost/${job.slug}/`,
    type: 'cost' as const,
  })),
];

const quickLaunchSlugs = [
  'concrete-slab-calculator',
  'paint-calculator',
  'drywall-calculator',
  'roofing-calculator',
  'mulch-calculator',
  'stair-calculator',
];
const quickLaunchCalcs = quickLaunchSlugs
  .map((s) => calculators.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const popularSlugs = [
  'paint-calculator',
  'concrete-slab-calculator',
  'roofing-calculator',
  'flooring-calculator',
  'mulch-calculator',
  'fence-calculator',
  'deck-calculator',
  'tile-calculator',
  'drywall-calculator',
  'gravel-calculator',
  'stair-calculator',
  'square-footage-calculator',
];

const popularCalculators = popularSlugs
  .map((s) => calculators.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const verifiedJobs = jobs.filter((j) => j.verified);
const preliminaryJobs = jobs.filter((j) => !j.verified).slice(0, 4);
const topStates = states.slice(0, 12);

// Deterministic Hero Workbench Specimens (computed live from BuildMath's exact formulas)
function computeHeroDefaults(slug: string) {
  const c = calculators.find((item) => item.slug === slug)!;
  const defaults = Object.fromEntries(c.inputs.map((inp) => [inp.name, inp.defaultValue]));
  return runCalculatorFormula(slug, defaults);
}

const slabRes = computeHeroDefaults('concrete-slab-calculator');
const paintRes = computeHeroDefaults('paint-calculator');
const roofRes = computeHeroDefaults('roofing-calculator');
const drywallRes = computeHeroDefaults('drywall-calculator');

const heroSpecimens: HeroSpecimenItem[] = [
  {
    id: 'slab',
    tabLabel: '01 Slab',
    eyebrow: 'CONCRETE SLAB',
    standardTag: 'ACI 302 · QUIKRETE',
    slug: 'concrete-slab-calculator',
    dimensionsLabel: '12 ft × 10 ft × 4 in + 10% waste → 1.63 yd³',
    primaryLabel: 'Ready-Mix Volume',
    primaryValue: `${slabRes.primaryResult.value} yd³`,
    primaryMeta: `Net ${slabRes.primaryResult.exactValue} yd³ · ${slabRes.secondaryResults[4]?.value || '$268.95'} truck`,
    secondaryLabel: 'Store Bag Equivalent',
    secondaryValue: `${slabRes.secondaryResults[0]?.value ?? 74} × 80-lb`,
    secondaryMeta: `Or ${slabRes.secondaryResults[1]?.value ?? 98} × 60-lb · Est. $${slabRes.costEstimate.typical.toFixed(2)}`,
    copySummary: `BuildMath Concrete Slab Takeoff (12×10 ft × 4 in, 10% waste): ${slabRes.primaryResult.value} cu yd ready-mix OR ${slabRes.secondaryResults[0]?.value} × 80-lb bags (Est. $${slabRes.costEstimate.typical.toFixed(2)})`,
  },
  {
    id: 'paint',
    tabLabel: '02 Paint',
    eyebrow: 'INTERIOR PAINT',
    standardTag: 'MPI · ASTM COV',
    slug: 'paint-calculator',
    dimensionsLabel: '12×12×8 ft · 2 doors, 2 windows · 2 coats',
    primaryLabel: 'Paint Quantity',
    primaryValue: `${paintRes.primaryResult.value} ${paintRes.primaryResult.unit}`,
    primaryMeta: `Exact: ${paintRes.primaryResult.exactValue} gal · 5% waste`,
    secondaryLabel: 'Net Paintable Area',
    secondaryValue: `${paintRes.secondaryResults[0]?.value ?? 312} sq ft`,
    secondaryMeta: `Est. $${Math.round(paintRes.costEstimate.typical)} (incl. roller kit)`,
    copySummary: `BuildMath Interior Paint Takeoff (12×12×8 ft, 2 coats): ${paintRes.primaryResult.value} gallons for ${paintRes.secondaryResults[0]?.value} net sq ft (Est. $${Math.round(paintRes.costEstimate.typical)} incl. kit)`,
  },
  {
    id: 'roof',
    tabLabel: '03 Roof',
    eyebrow: 'ROOF SHINGLES',
    standardTag: 'ARMA · NRCA',
    slug: 'roofing-calculator',
    dimensionsLabel: '50×40 ft footprint · 6/12 pitch + 10% waste',
    primaryLabel: 'Shingle Bundles',
    primaryValue: `${roofRes.primaryResult.value} bundles`,
    primaryMeta: `${roofRes.secondaryResults[0]?.value} sq · ${roofRes.secondaryResults[1]?.value} sq ft slope`,
    secondaryLabel: 'Full Roof BOM',
    secondaryValue: `$${Math.round(roofRes.costEstimate.typical).toLocaleString()}`,
    secondaryMeta: 'Shingles, felt, edge & cap',
    copySummary: `BuildMath Roofing Takeoff (50×40 ft, 6/12 pitch, 10% waste): ${roofRes.primaryResult.value} shingle bundles (${roofRes.secondaryResults[0]?.value} squares) + felt/cap (Est. $${Math.round(roofRes.costEstimate.typical).toLocaleString()})`,
  },
  {
    id: 'drywall',
    tabLabel: '04 Drywall',
    eyebrow: 'DRYWALL SHEETS',
    standardTag: 'USG HANDBOOK',
    slug: 'drywall-calculator',
    dimensionsLabel: '12×12×8 ft + ceiling · 10% waste',
    primaryLabel: '4×8 Panels Needed',
    primaryValue: `${drywallRes.primaryResult.value} sheets`,
    primaryMeta: `${drywallRes.secondaryResults[0]?.value} sq ft · ${drywallRes.materials[1]?.quantity ?? 2} mud pails`,
    secondaryLabel: 'Hardware & Fasteners',
    secondaryValue: `${drywallRes.secondaryResults[3]?.value ?? 512} screws`,
    secondaryMeta: `1 roll tape · Est. $${drywallRes.costEstimate.typical.toFixed(2)}`,
    copySummary: `BuildMath Drywall Takeoff (12×12×8 ft + ceiling, 10% waste): ${drywallRes.primaryResult.value} × 4×8 sheets, 2 × 4.5-gal mud buckets, ${drywallRes.secondaryResults[3]?.value} screws (Est. $${drywallRes.costEstimate.typical.toFixed(2)})`,
  },
];
---

<BaseLayout
  title="BuildMath: Free DIY & Home Improvement Calculators + Cost Guides"
  description="Get accurate DIY material quantities and local project cost estimates in under 10 seconds. 32 source-cited home improvement calculators for US homeowners."
  pathname="/"
>
  <!-- 1. HERO SECTION: Asymmetric Architectural Workbench + Live Switchable CAD Specimen -->
  <section class="relative overflow-hidden rounded-2xl border border-hairline bg-surface bm-cad-grid bm-corner-ticks p-6 sm:p-10 lg:p-12 mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- Hero Left: Value Prop + Command Search + Primary CTAs -->
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-graphite-900 text-[#F8F8F5] font-mono text-[10px] sm:text-[11px] font-semibold tracking-wider uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-lime-500 shrink-0"></span>
          <span>Construction Material &amp; Cost Engine // US Specs</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ink leading-[1.06]">
          Accurate Home-Improvement Math Built for Real Store Orders
        </h1>

        <p class="text-sm sm:text-base text-ink-body max-w-2xl leading-relaxed">
          Convert raw room or slab measurements into exact purchasable bags, gallons, bundles, sheets, and cubic yards in seconds—backed by editable trade defaults and US state labor indices.
        </p>

        <!-- Functional SearchBar -->
        <div class="pt-1">
          <SearchBox client:load items={searchItems} />
        </div>

        <div class="flex flex-wrap items-center gap-2.5 pt-1">
          <a href="/calculators/" class="bm-btn-lime text-xs sm:text-sm font-bold">
            <span>Explore All 32 Calculators</span>
            <Icon name="arrow-right" size={15} />
          </a>
          <a href="/my-project/" class="bm-btn-secondary text-xs sm:text-sm">
            <Icon name="clipboard-list" size={15} class="text-blueprint" />
            <span>Open Project Workspace</span>
          </a>
        </div>

        <div class="pt-2 flex flex-wrap items-center gap-1.5 text-xs">
          <span class="font-mono text-[10px] uppercase tracking-wider text-ink-muted mr-1">Popular:</span>
          <a href="/calculators/paint-calculator/" class="px-2.5 py-1 rounded bg-canvas border border-hairline hover:border-blueprint text-ink transition-colors">
            Paint
          </a>
          <a href="/calculators/concrete-slab-calculator/" class="px-2.5 py-1 rounded bg-canvas border border-hairline hover:border-blueprint text-ink transition-colors">
            Concrete Slab
          </a>
          <a href="/calculators/drywall-calculator/" class="px-2.5 py-1 rounded bg-canvas border border-hairline hover:border-blueprint text-ink transition-colors">
            Drywall
          </a>
          <a href="/calculators/roofing-calculator/" class="px-2.5 py-1 rounded bg-canvas border border-hairline hover:border-blueprint text-ink transition-colors">
            Roofing Shingles
          </a>
          <a href="/calculators/stair-calculator/" class="px-2.5 py-1 rounded bg-canvas border border-hairline hover:border-blueprint text-ink transition-colors">
            Stair Stringers
          </a>
        </div>
      </div>

      <!-- Hero Right: 4-Mode Interactive Switchable CAD Workbench (rive.app specimen console) -->
      <HeroSpecimenConsole client:load specimens={heroSpecimens} />
    </div>
  </section>

  <!-- 2. QUICK-ACCESS WORKBENCH & RECENTLY USED -->
  <RecentCalculators client:idle />

  <section class="mb-16" aria-labelledby="quick-access-heading">
    <div class="bm-section-rule">
      <span class="bm-section-index">01 // DIRECT LAUNCH</span>
      <div class="bm-section-line"></div>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-5">
      <div>
        <h2 id="quick-access-heading" class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
          Quick-Access Calculators
        </h2>
      </div>
      <a href="/calculators/" class="bm-pill-cta shrink-0">
        <span>Filter &amp; Sort All 32</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">
      {quickLaunchCalcs.map((calc) => {
        const meta = CALCULATOR_CATALOG_META[calc.slug];
        const sch = meta?.schematic ? SCHEMATIC_PATHS[meta.schematic] : null;
        return (
          <a
            href={`/calculators/${calc.slug}/`}
            class="bm-panel bm-card-invert p-3.5 flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <Icon name={getCategoryIconName(calc.category)} size={15} class="text-blueprint" />
                {sch && (
                  <svg viewBox="0 0 32 22" width="28" height="19" aria-hidden="true" class="text-ink-muted group-hover:text-blueprint transition-colors" set:html={sch} />
                )}
              </div>
              <h3 class="text-sm font-bold text-ink group-hover:text-blueprint transition-colors leading-snug">
                {calc.shortName}
              </h3>
              <p class="font-mono text-[10px] text-ink-muted truncate mt-1">
                {meta?.outputsLabel}
              </p>
            </div>
            <div class="bm-arrow-glide mt-3 pt-2 border-t border-hairline flex items-center justify-between font-mono text-[10px] font-semibold text-blueprint">
              <span>Calculate</span>
              <Icon name="arrow-up-right" size={12} />
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 3. ALL 8 TRADE CATEGORIES: Engineering Matrix -->
  <section class="mb-16" aria-labelledby="categories-heading">
    <div class="bm-section-rule">
      <span class="bm-section-index">02 // TRADE MATRIX · 08 DISCIPLINES</span>
      <div class="bm-section-line"></div>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <h2 id="categories-heading" class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
          Residential Construction Trades
        </h2>
        <p class="text-sm text-ink-muted mt-1">
          Every trade module includes source-cited defaults, store packaging math, and direct cost guide links.
        </p>
      </div>
      <a href="/calculators/" class="bm-pill-cta shrink-0">
        <span>Browse Directory</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {categories.map((cat, idx) => {
        const catCalcs = calculators.filter((c) => c.category === cat.slug);
        return (
          <div class="bm-panel bm-card-invert p-5 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2">
                  <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-surface-subtle border border-hairline text-blueprint">
                    <Icon name={getCategoryIconName(cat.slug)} size={16} />
                  </span>
                  <span class="bm-invert-badge font-mono text-[10px] font-semibold px-2 py-0.5 rounded bg-surface-subtle text-ink-muted border border-hairline transition-colors">
                    TRADE // {String(idx + 1).padStart(2, '0')}
                  </span>
                </div>
                <span class="font-mono text-[10px] font-semibold px-2 py-0.5 rounded bg-surface-subtle text-ink-muted border border-hairline tabular-nums">
                  {String(catCalcs.length).padStart(2, '0')}
                </span>
              </div>

              <a href={`/calculators/${cat.slug}/`} class="group block">
                <h3 class="text-base font-bold text-ink group-hover:text-blueprint transition-colors">
                  {cat.name}
                </h3>
              </a>
              <div class="font-mono text-[10px] text-blueprint mt-1">
                {tradeStandards[cat.slug] || 'US Standard Specs'}
              </div>
              <p class="text-xs text-ink-muted mt-2 mb-3.5 leading-relaxed line-clamp-2">
                {cat.description}
              </p>

              <ul class="space-y-1.5 text-xs border-t border-hairline pt-3">
                {catCalcs.map((c) => (
                  <li>
                    <a
                      href={`/calculators/${c.slug}/`}
                      class="flex items-center justify-between gap-2 text-ink-body hover:text-blueprint transition-colors group/link"
                    >
                      <span class="truncate">{c.shortName}</span>
                      <Icon name="chevron-right" size={12} class="opacity-40 group-hover/link:opacity-100 shrink-0" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={`/calculators/${cat.slug}/`}
              class="mt-4 pt-3 border-t border-hairline inline-flex items-center justify-between text-xs font-semibold text-blueprint hover:underline"
            >
              <span>Open {cat.shortName} Hub</span>
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        );
      })}
    </div>
  </section>

  <!-- 4. 12 POPULAR CALCULATORS: Structured 3-Part Discovery Cards -->
  <section class="mb-16" aria-labelledby="popular-calcs-heading">
    <div class="bm-section-rule">
      <span class="bm-section-index">03 // CORE INSTRUMENTS</span>
      <div class="bm-section-line"></div>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <h2 id="popular-calcs-heading" class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
          12 Essential Estimation Calculators
        </h2>
        <p class="text-sm text-ink-muted mt-1">
          Required inputs, calculated store units, and CAD diagrams visible upfront on every tool.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {popularCalculators.map((calc) => {
        const meta = CALCULATOR_CATALOG_META[calc.slug];
        const sch = meta?.schematic ? SCHEMATIC_PATHS[meta.schematic] : null;
        return (
          <a
            href={`/calculators/${calc.slug}/`}
            class="bm-panel bm-card-invert p-5 group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="inline-flex items-center gap-1.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-blueprint bg-blueprint-soft px-2 py-0.5 rounded">
                  <Icon name={getCategoryIconName(calc.category)} size={12} />
                  {categoryMap[calc.category]}
                </span>
                {sch ? (
                  <svg viewBox="0 0 32 22" width="32" height="22" aria-hidden="true" class="text-blueprint opacity-75 group-hover:opacity-100 shrink-0" set:html={sch} />
                ) : (
                  <Icon name="arrow-up-right" size={15} class="text-ink-muted group-hover:text-ink transition-colors" />
                )}
              </div>
              <h3 class="text-base font-bold text-ink group-hover:text-blueprint transition-colors">
                {calc.name}
              </h3>
              <p class="mt-1 text-xs sm:text-[13px] text-ink-muted line-clamp-2 leading-snug">
                {meta?.summaryDesc || calc.intro}
              </p>
              {meta && (
                <dl class="mt-3 pt-2.5 border-t border-hairline space-y-1 text-[11px]">
                  <div class="flex items-baseline gap-2">
                    <dt class="font-mono font-semibold uppercase text-ink-muted w-14 shrink-0">Inputs:</dt>
                    <dd class="text-ink-body truncate">{meta.inputsLabel}</dd>
                  </div>
                  <div class="flex items-baseline gap-2">
                    <dt class="font-mono font-semibold uppercase text-ink-muted w-14 shrink-0">Outputs:</dt>
                    <dd class="text-ink font-medium truncate">{meta.outputsLabel}</dd>
                  </div>
                </dl>
              )}
            </div>
            <div class="mt-4 pt-3 border-t border-hairline flex items-center justify-between text-xs font-semibold text-ink">
              <span class="group-hover:text-blueprint transition-colors">Open Calculator</span>
              <Icon name="arrow-right" size={14} class="text-blueprint group-hover:translate-x-0.5 transition-transform" />
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 5. TECHNICAL CREDIBILITY LEDGER & 6. SYSTEM METHODOLOGY -->
  <section class="mb-16 space-y-6" aria-labelledby="credibility-heading">
    <!-- Audited Verification Ledger -->
    <div class="bm-instrument-rim overflow-hidden">
      <div class="px-6 py-4 border-b border-graphite-700 bg-graphite-950/70 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-lime-500">
          <Icon name="shield-check" size={14} />
          <span>Technical Verification &amp; Data Integrity Ledger</span>
        </div>
        <span class="font-mono text-[11px] text-[#9BA1AA]">Audited CI Status</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-graphite-700">
        <div class="p-5 sm:p-6">
          <div class="font-mono text-2xl sm:text-3xl font-extrabold text-lime-500 tabular-nums">100 Tests</div>
          <h3 id="credibility-heading" class="text-sm font-bold text-[#F8F8F5] mt-1">
            Automated Formula Suite
          </h3>
          <p class="text-xs text-[#9BA1AA] mt-1.5 leading-relaxed">
            Every formula module in TypeScript runs deterministic assertions for geometry, edge cases, and ceiling rounding in Vitest.
          </p>
        </div>

        <div class="p-5 sm:p-6">
          <div class="font-mono text-2xl sm:text-3xl font-extrabold text-[#F8F8F5] tabular-nums">32 / 32</div>
          <h3 class="text-sm font-bold text-[#F8F8F5] mt-1">
            Visible, Editable Defaults
          </h3>
          <p class="text-xs text-[#9BA1AA] mt-1.5 leading-relaxed">
            Slab thickness, depth, pitch, waste factors, coverage yields, and unit prices can all be verified and overridden inline.
          </p>
        </div>

        <div class="p-5 sm:p-6">
          <div class="font-mono text-2xl sm:text-3xl font-extrabold text-[#6FA3D2] tabular-nums">3 Verified</div>
          <h3 class="text-sm font-bold text-[#F8F8F5] mt-1">
            vs. 22 Preliminary Cost Drafts
          </h3>
          <p class="text-xs text-[#9BA1AA] mt-1.5 leading-relaxed">
            Flagship roofing, interior painting, and concrete patio guides are verified bottom-up; remaining 22 drafts carry a Draft tag and noindex guard.
          </p>
        </div>

        <div class="p-5 sm:p-6">
          <div class="font-mono text-2xl sm:text-3xl font-extrabold text-[#F8F8F5] tabular-nums">0 / 0</div>
          <h3 class="text-sm font-bold text-[#F8F8F5] mt-1">
            Zero-Account Local Storage
          </h3>
          <p class="text-xs text-[#9BA1AA] mt-1.5 leading-relaxed">
            All calculations execute inside your browser with CI crawling every static route to verify zero broken links or orphan pages.
          </p>
        </div>
      </div>
    </div>

    <!-- System Methodology Pipeline -->
    <div class="bm-panel overflow-hidden">
      <div class="px-6 py-5 border-b border-hairline bg-surface-subtle/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <span class="bm-eyebrow-blue mb-1.5">Deterministic Estimation Pipeline</span>
          <h2 class="text-xl sm:text-2xl font-bold text-ink tracking-tight">
            How BuildMath Translates Dimensions Into Purchasing Lists
          </h2>
        </div>
        <a href="/methodology/" class="bm-btn-secondary text-xs shrink-0">
          <span>Full Formula Documentation</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12">
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-hairline">
          <div class="p-5 space-y-2">
            <span class="font-mono text-[11px] font-bold text-blueprint">01 // MEASURE</span>
            <h3 class="text-sm font-bold text-ink">Dimensions &amp; Units</h3>
            <p class="text-xs text-ink-muted leading-relaxed">
              Enter ft/in or metric measurements, deduct openings, and adjust thickness or slope geometry directly.
            </p>
          </div>
          <div class="p-5 space-y-2">
            <span class="font-mono text-[11px] font-bold text-blueprint">02 // ROUND UP</span>
            <h3 class="text-sm font-bold text-ink">Store Packaging</h3>
            <p class="text-xs text-ink-muted leading-relaxed">
              See both net unrounded engineering volume and retail store counts (<code class="font-mono text-ink">Math.ceil</code>) across bag or carton sizes.
            </p>
          </div>
          <div class="p-5 space-y-2">
            <span class="font-mono text-[11px] font-bold text-blueprint">03 // LOCALIZE</span>
            <h3 class="text-sm font-bold text-ink">State Labor &amp; BOM</h3>
            <p class="text-xs text-ink-muted leading-relaxed">
              Adjust contractor quotes using BLS occupational wages and BEA Regional Price Parities across 50 states.
            </p>
          </div>
        </div>

        <div class="lg:col-span-5 p-5 bg-surface-subtle/50 border-t lg:border-t-0 lg:border-l border-hairline flex flex-col justify-between gap-3">
          <div>
            <span class="font-mono text-[10px] uppercase tracking-wider text-ink-muted block mb-1.5">
              State Cost Scaling Formula
            </span>
            <div class="p-3 rounded-lg bg-graphite-900 text-[#F8F8F5] font-mono text-[11px] leading-relaxed overflow-x-auto border border-graphite-700">
              Cost<sub>state</sub> = National × [LaborShare × (BLS<sub>state</sub>/BLS<sub>US</sub>) + MatShare × (RPP<sub>state</sub>/100)]
            </div>
          </div>
          <div class="flex flex-wrap gap-1.5 font-mono text-[10px] text-ink-muted">
            <span class="px-2 py-0.5 rounded bg-surface border border-hairline">ACI 318</span>
            <span class="px-2 py-0.5 rounded bg-surface border border-hairline">ARMA / NRCA</span>
            <span class="px-2 py-0.5 rounded bg-surface border border-hairline">USG Handbook</span>
            <span class="px-2 py-0.5 rounded bg-surface border border-hairline">2024 IRC R311</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. PROMINENT PROJECT WORKSPACE PROMOTIONAL + LIVE PREVIEW -->
  <WorkspaceShowcase client:idle />

  <!-- 8. COST-GUIDE DISCOVERY & VERIFICATION CLARITY -->
  <section class="mb-16" aria-labelledby="cost-guides-heading">
    <div class="bm-section-rule">
      <span class="bm-section-index">04 // BENCHMARK COSTING</span>
      <div class="bm-section-line"></div>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <h2 id="cost-guides-heading" class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">
          Home Improvement Cost Guides by State
        </h2>
        <p class="text-sm text-ink-muted mt-1">
          Bottom-up verified flagship models are explicitly separated from preliminary trade drafts.
        </p>
      </div>
      <a href="/cost/" class="bm-pill-cta shrink-0">
        <span>All 25 Cost Guides</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </div>

    <!-- Bottom-Up Verified Cost Models -->
    <div class="mb-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="h-2 w-2 rounded-full bg-lime-500"></span>
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-ink">
          Bottom-Up Verified Cost Models ({verifiedJobs.length})
        </h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {verifiedJobs.map((job) => (
          <a
            href={`/cost/${job.slug}/`}
            class="bm-panel bm-panel-hover p-5 border-t-4 border-t-[#C6F36A] flex flex-col justify-between group hover:border-blueprint/75"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-lime-500/20 text-ink dark:text-lime-500 border border-lime-500/40 font-mono text-[10px] font-semibold">
                  <span class="h-1.5 w-1.5 rounded-full bg-lime-500"></span>
                  Verified Model
                </span>
                <span class="font-mono text-[10px] text-ink-muted uppercase tabular-nums">
                  {job.typicalProjectSize.toLocaleString()} {job.unit}
                </span>
              </div>
              <h4 class="text-base font-bold text-ink group-hover:text-blueprint transition-colors">
                Cost of {job.name}
              </h4>
              <p class="text-xs text-ink-muted mt-1.5 leading-relaxed line-clamp-2">
                {job.diySavingsNote}
              </p>
              <div class="mt-3 pt-3 border-t border-hairline flex items-center justify-between text-xs tabular-nums">
                <span class="text-ink-muted">US National Typical</span>
                <strong class="font-mono text-sm font-bold text-ink">
                  ${Math.round(job.nationalTypicalPerUnit * job.typicalProjectSize).toLocaleString()}
                </strong>
              </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-hairline flex items-center justify-between text-xs font-semibold text-blueprint">
              <span>50-State Breakdown</span>
              <Icon name="arrow-right" size={13} />
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Preliminary Draft Cost Models (Explicitly Labelled) -->
    <div class="mb-6">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-ink-muted">
          Preliminary Trade Drafts (Calc Baseline · Unverified)
        </h3>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {preliminaryJobs.map((job) => (
          <a
            href={`/cost/${job.slug}/`}
            class="bm-panel bm-panel-hover p-4 flex flex-col justify-between group hover:border-hairline-strong"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-surface-subtle text-ink-muted border border-hairline font-mono text-[10px] font-medium">
                  Preliminary Draft
                </span>
                <span class="font-mono text-[10px] text-ink-muted uppercase tabular-nums">
                  {job.typicalProjectSize.toLocaleString()} {job.unit}
                </span>
              </div>
              <h4 class="text-sm font-bold text-ink group-hover:text-blueprint transition-colors">
                Cost of {job.name}
              </h4>
              <p class="text-xs text-ink-muted mt-1 tabular-nums">
                Baseline Estimate:{' '}
                <strong class="text-ink font-semibold">
                  ${Math.round(job.nationalTypicalPerUnit * job.typicalProjectSize).toLocaleString()}
                </strong>
              </p>
            </div>
            <div class="mt-3 pt-2.5 border-t border-hairline flex items-center justify-between text-xs font-medium text-ink-muted group-hover:text-blueprint">
              <span>Inspect Draft</span>
              <Icon name="arrow-right" size={13} />
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- 50-State Quick Jump Grid -->
    <div class="bm-panel p-5 bg-surface-subtle/50">
      <div class="flex items-center justify-between gap-2 mb-3">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-ink">
          Regional Lookup // Verified Roof Replacement Cost by State
        </h3>
        <Icon name="map-pin" size={15} class="text-blueprint" />
      </div>
      <div class="flex flex-wrap gap-2">
        {topStates.map((st) => (
          <a
            href={`/cost/roof-replacement/${st.slug}/`}
            class="px-3 py-1.5 rounded-md text-xs font-medium bg-surface border border-hairline hover:border-blueprint text-ink transition-colors"
          >
            {st.name} <span class="font-mono text-ink-muted">({st.abbr})</span>
          </a>
        ))}
        <a
          href="/cost/roof-replacement/"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-md text-xs font-semibold text-blueprint hover:underline"
        >
          <span>All 50 States + DC</span>
          <Icon name="arrow-right" size={13} />
        </a>
      </div>
    </div>
  </section>

  <!-- 9. FIELD GUIDES SECTION -->
  <section aria-labelledby="guides-heading">
    <div class="bm-section-rule">
      <span class="bm-section-index">05 // FIELD DOCUMENTATION</span>
      <div class="bm-section-line"></div>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <h2 id="guides-heading" class="text-2xl font-extrabold text-ink tracking-tight">
          Measurement &amp; Estimation Guides
        </h2>
        <p class="text-sm text-ink-muted mt-1">
          Practical field procedures for measuring rooms, roof slope geometry, and waste allowances compiled by {siteConfig.author.name}.
        </p>
      </div>
      <a href="/guides/" class="bm-pill-cta shrink-0">
        <span>All {guides.length} Field Guides</span>
        <Icon name="arrow-right" size={14} />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {guides.slice(0, 3).map((g, idx) => (
        <a href={`/guides/${g.slug}/`} class="bm-panel bm-card-invert p-5 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3 font-mono text-[11px] text-ink-muted">
              <span class="text-blueprint font-semibold">GUIDE // {String(idx + 1).padStart(2, '0')}</span>
              <span class="inline-flex items-center gap-1">
                <Icon name="clock" size={12} />
                {g.readingTime}
              </span>
            </div>
            <h3 class="text-base font-bold text-ink group-hover:text-blueprint transition-colors">
              {g.title}
            </h3>
            <p class="mt-2 text-xs sm:text-sm text-ink-muted line-clamp-2 leading-relaxed">
              {g.excerpt}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-hairline flex items-center justify-between text-xs font-semibold text-blueprint">
            <span>Read Field Guide</span>
            <Icon name="arrow-right" size={14} />
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
