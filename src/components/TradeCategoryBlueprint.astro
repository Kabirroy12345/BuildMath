---
interface Props {
  categorySlug: string;
}

const { categorySlug } = Astro.props;
---

<div class="rounded bg-graphite-950 border border-graphite-700 bm-cad-grid p-3 bm-corner-ticks">
  <div class="flex items-center justify-between mb-1.5 font-mono text-[9px] uppercase tracking-wider text-[#6FA3D2]">
    <span>ARCHITECTURAL SCHEMATIC</span>
    <span class="text-lime-500">CAD // {categorySlug.toUpperCase()}</span>
  </div>

  {categorySlug === 'painting' && (
    <svg viewBox="0 0 260 110" class="w-full h-24" data-draw-svg role="img" aria-label="Painting wall elevation and excluded opening schematic">
      <rect x="26" y="14" width="208" height="72" fill="rgba(71,121,168,0.16)" stroke="#6FA3D2" stroke-width="1.6" />
      <rect x="46" y="34" width="28" height="52" fill="#101215" stroke="#C6F36A" stroke-width="1.3" stroke-dasharray="3 2" />
      <rect x="134" y="26" width="52" height="32" fill="#101215" stroke="#C6F36A" stroke-width="1.3" stroke-dasharray="3 2" />
      <line x1="160" y1="26" x2="160" y2="58" stroke="#6FA3D2" stroke-width="1" />
      <line x1="134" y1="42" x2="186" y2="42" stroke="#6FA3D2" stroke-width="1" />
      <text x="130" y="101" font-size="9" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">
        WALL AREA = Σ(L×H) − 21 SF DOOR − 15 SF WIN
      </text>
    </svg>
  )}

  {categorySlug === 'flooring' && (
    <svg viewBox="0 0 260 110" class="w-full h-24" data-draw-svg role="img" aria-label="Flooring tile and plank course grid with cut waste zone">
      <rect x="24" y="14" width="212" height="68" fill="rgba(71,121,168,0.14)" stroke="#6FA3D2" stroke-width="1.6" />
      <rect x="200" y="14" width="36" height="68" fill="rgba(198,243,106,0.16)" stroke="#C6F36A" stroke-width="1.2" stroke-dasharray="3 2" />
      <line x1="24" y1="36" x2="200" y2="36" stroke="#6FA3D2" stroke-width="1" />
      <line x1="24" y1="58" x2="200" y2="58" stroke="#6FA3D2" stroke-width="1" />
      <line x1="82" y1="14" x2="82" y2="82" stroke="#6FA3D2" stroke-width="1" />
      <line x1="141" y1="14" x2="141" y2="82" stroke="#6FA3D2" stroke-width="1" />
      <text x="130" y="101" font-size="9" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">
        GROUT JOINT + +10–15% DIAGONAL WASTE BUFFER
      </text>
    </svg>
  )}

  {categorySlug === 'concrete-masonry' && (
    <svg viewBox="0 0 260 110" class="w-full h-24" data-draw-svg role="img" aria-label="Isometric concrete slab thickness and rebar grid diagram">
      <polygon points="34,38 186,20 226,44 74,62" fill="rgba(71,121,168,0.2)" stroke="#6FA3D2" stroke-width="1.6" />
      <polygon points="34,38 74,62 74,80 34,56" fill="rgba(198,243,106,0.22)" stroke="#C6F36A" stroke-width="1.4" />
      <polygon points="74,62 226,44 226,62 74,80" fill="rgba(71,121,168,0.12)" stroke="#6FA3D2" stroke-width="1.4" />
      <line x1="68" y1="34" x2="196" y2="48" stroke="rgba(198,243,106,0.5)" stroke-width="1" />
      <line x1="112" y1="29" x2="152" y2="53" stroke="rgba(198,243,106,0.5)" stroke-width="1" />
      <text x="130" y="101" font-size="9" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">
        1 CU YD = 27 CU FT · 80-LB BAG = 0.60 CU FT
      </text>
    </svg>
  )}

  {categorySlug === 'roofing' && (
    <svg viewBox="0 0 260 110" class="w-full h-24" data-draw-svg role="img" aria-label="Gable roof secant pitch triangle and slope schematic">
      <polygon points="28,76 130,18 232,76" fill="rgba(71,121,168,0.16)" stroke="#6FA3D2" stroke-width="1.75" />
      <line x1="130" y1="18" x2="130" y2="76" stroke="#9BA1AA" stroke-width="1" stroke-dasharray="3 3" />
      <polyline points="68,54 108,54 108,31" fill="none" stroke="#C6F36A" stroke-width="1.5" />
      <text x="88" y="65" font-size="8.5" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">
        12" RUN
      </text>
      <text x="130" y="101" font-size="9" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">
        PITCH MULTIPLIER = √(1 + (RISE / 12)²)
      </text>
    </svg>
  )}

  {categorySlug === 'landscaping' && (
    <svg viewBox="0 0 260 110" class="w-full h-24" data-draw-svg role="img" aria-label="Compacted landscape depth cutaway across subgrade and mulch layers">
      <rect x="26" y="22" width="208" height="22" fill="rgba(198,243,106,0.16)" stroke="#C6F36A" stroke-width="1.4" />
      <rect x="26" y="44" width="208" height="20" fill="rgba(71,121,168,0.18)" stroke="#6FA3D2" stroke-width="1.4" />
      <rect x="26" y="64" width="208" height="16" fill="rgba(42,48,56,0.65)" stroke="#6FA3D2" stroke-width="1.2" stroke-dasharray="3 2" />
      <text x="130" y="36" font-size="8.5" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">
        TOP LAYER (2–4" DEPTH)
      </text>
      <text x="130" y="101" font-size="9" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">
        CU YD = AREA × (DEPTH IN / 12) ÷ 27 + COMPACT
      </text>
    </svg>
  )}

  {categorySlug === 'fencing-decking' && (
    <svg viewBox="0 0 260 110" class="w-full h-24" data-draw-svg role="img" aria-label="Fence post spacing and frost footing depth diagram">
      <line x1="20" y1="62" x2="240" y2="62" stroke="#9BA1AA" stroke-width="1" stroke-dasharray="4 2" />
      <rect x="44" y="16" width="9" height="66" fill="#C6F36A" />
      <rect x="125" y="16" width="9" height="66" fill="#C6F36A" />
      <rect x="206" y="16" width="9" height="66" fill="#C6F36A" />
      <line x1="53" y1="30" x2="206" y2="30" stroke="#6FA3D2" stroke-width="2" />
      <line x1="53" y1="48" x2="206" y2="48" stroke="#6FA3D2" stroke-width="2" />
      <text x="130" y="101" font-size="9" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">
        6–8 FT POST OC · CALL 811 BEFORE DIGGING
      </text>
    </svg>
  )}

  {categorySlug === 'drywall-walls' && (
    <svg viewBox="0 0 260 110" class="w-full h-24" data-draw-svg role="img" aria-label="Staggered drywall panels and IRC R311 staircase rise/run schematic">
      <rect x="24" y="16" width="58" height="32" fill="rgba(71,121,168,0.18)" stroke="#6FA3D2" stroke-width="1.3" />
      <rect x="82" y="16" width="58" height="32" fill="rgba(198,243,106,0.14)" stroke="#C6F36A" stroke-width="1.3" />
      <rect x="24" y="48" width="29" height="32" fill="rgba(71,121,168,0.12)" stroke="#6FA3D2" stroke-width="1.3" />
      <rect x="53" y="48" width="58" height="32" fill="rgba(198,243,106,0.18)" stroke="#C6F36A" stroke-width="1.3" />
      <polyline points="154,80 154,60 178,60 178,40 202,40 202,20 232,20 232,80 154,80" fill="rgba(71,121,168,0.16)" stroke="#C6F36A" stroke-width="1.4" />
      <text x="130" y="101" font-size="9" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">
        USG 1.125 GAL/100 SF · IRC MAX RISER 7.75"
      </text>
    </svg>
  )}

  {categorySlug === 'general-conversions' && (
    <svg viewBox="0 0 260 110" class="w-full h-24" data-draw-svg role="img" aria-label="Planimetric L-shape zone division and volumetric cube conversion">
      <rect x="30" y="18" width="110" height="58" fill="rgba(71,121,168,0.2)" stroke="#6FA3D2" stroke-width="1.5" />
      <rect x="140" y="40" width="84" height="36" fill="rgba(198,243,106,0.18)" stroke="#C6F36A" stroke-width="1.5" />
      <line x1="140" y1="40" x2="140" y2="76" stroke="#C6F36A" stroke-width="1.5" stroke-dasharray="3 2" />
      <text x="85" y="50" font-size="9" font-family="JetBrains Mono, monospace" fill="#F8F8F5" text-anchor="middle" class="bm-stroke-annotation">
        ZONE A1
      </text>
      <text x="182" y="61" font-size="9" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">
        ZONE A2
      </text>
      <text x="130" y="101" font-size="9" font-family="JetBrains Mono, monospace" fill="#C6F36A" text-anchor="middle" class="bm-stroke-annotation">
        1 CU YD = 27 CU FT · 1 BD FT = 144 CU IN
      </text>
    </svg>
  )}
</div>
