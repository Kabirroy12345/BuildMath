---
import { monetizationConfig, type AdPosition } from '../config/monetization';

interface Props {
  position: AdPosition;
  className?: string;
}

const { position, className = '' } = Astro.props;
const slot = monetizationConfig.adSlots[position];
const enabled = monetizationConfig.adsEnabled;
---

{enabled && (
  <aside
    aria-label="Advertisement"
    class:list={[
      'ad-slot my-8 w-full flex flex-col items-center justify-center rounded-xl border border-dashed border-hairline bg-surface-subtle/60 p-3',
      className,
    ]}
    style={`min-height: ${slot.minHeightPx + 28}px;`}
  >
    <span class="font-mono text-[10px] uppercase tracking-wider text-ink-muted mb-1">
      {slot.label}
    </span>
    <div
      id={slot.id}
      class="w-full flex items-center justify-center text-xs text-ink-muted"
      style={`min-height: ${slot.minHeightPx}px;`}
    >
      <!-- Reserved zero-CLS slot container -->
    </div>
  </aside>
)}
