---
import Icon from './Icon.astro';
import { monetizationConfig } from '../config/monetization';

interface Props {
  jobTitle: string;
  stateName?: string;
}

const { jobTitle, stateName } = Astro.props;
const locationLabel = stateName ? `in ${stateName}` : 'in your area';
---

{monetizationConfig.leadGenEnabled ? (
  <section class="my-8 bm-panel p-6 border-l-4 border-l-[#C6F36A]">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <span class="bm-eyebrow-blue mb-2">Licensed Local Pros</span>
        <h3 class="text-lg sm:text-xl font-bold text-ink">
          Get 3 Free Quotes for {jobTitle} {locationLabel}
        </h3>
        <p class="text-sm text-ink-body mt-1">
          Compare itemized bids from licensed, insured local contractors before starting your project.
        </p>
      </div>
      <form class="flex flex-col sm:flex-row gap-2 shrink-0" action="/contact/" method="get">
        <label for="lead-zip" class="sr-only">ZIP Code</label>
        <input
          id="lead-zip"
          name="zip"
          type="text"
          inputmode="numeric"
          pattern="[0-9]{5}"
          maxlength="5"
          placeholder="Enter ZIP Code"
          required
          class="bm-input sm:w-36"
        />
        <button type="submit" class="bm-btn-lime whitespace-nowrap">
          Compare Quotes
          <Icon name="arrow-right" size={16} />
        </button>
      </form>
    </div>
  </section>
) : (
  <aside class="my-8 bm-panel p-5 sm:p-6 bg-surface-subtle/60">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-start gap-3.5">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-surface border border-hairline text-blueprint mt-0.5">
          <Icon name="shield-check" size={18} />
        </span>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-ink">
            Hiring a pro vs. DIY for {jobTitle.toLowerCase()} {locationLabel}?
          </h3>
          <p class="text-xs sm:text-sm text-ink-body mt-1 leading-relaxed">
            Request at least 3 written, itemized bids that separate material quantities from labor hours, and verify contractor licensing directly on your state board registry.
          </p>
        </div>
      </div>
      <a href="/methodology/" class="bm-btn-secondary text-xs shrink-0 whitespace-nowrap">
        Cost Methodology
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
  </aside>
)}
