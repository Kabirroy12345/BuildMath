---
import { buildFAQPageSchema, type FAQItem } from '../lib/seo/schema';

interface Props {
  faqs: FAQItem[];
  title?: string;
}

const { faqs, title = 'Frequently Asked Questions' } = Astro.props;
const schema = buildFAQPageSchema(faqs);
---

{faqs && faqs.length > 0 && (
  <section class="my-10" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-2xl font-bold text-slate-900 dark:text-white mb-5">
      {title}
    </h2>
    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details
          class="group card p-5 open:border-brand-300 dark:open:border-brand-700 transition-colors"
          open={index === 0}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-slate-900 dark:text-slate-100 text-base">
            <span>{faq.question}</span>
            <span
              aria-hidden="true"
              class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 group-open:rotate-180 transition-transform"
            >
              ▼
            </span>
          </summary>
          <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 text-slate-700 dark:text-slate-300 leading-relaxed text-sm sm:text-base">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </section>
)}
