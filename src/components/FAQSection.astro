---
import Icon from './Icon.astro';
import { buildFAQPageSchema, type FAQItem } from '../lib/seo/schema';

interface Props {
  faqs: FAQItem[];
  title?: string;
}

const { faqs, title = 'Frequently Asked Questions' } = Astro.props;
const schema = buildFAQPageSchema(faqs);
---

{faqs && faqs.length > 0 && (
  <section class="my-10" aria-labelledby="faq-heading">
    <div class="mb-5 flex items-center justify-between gap-4">
      <div>
        <span class="bm-eyebrow mb-2">Documentation // FAQ</span>
        <h2 id="faq-heading" class="text-xl sm:text-2xl font-bold tracking-tight text-ink">
          {title}
        </h2>
      </div>
    </div>

    <div class="divide-y divide-hairline rounded-xl border border-hairline bg-surface overflow-hidden">
      {faqs.map((faq, index) => (
        <details class="group transition-colors open:bg-surface-subtle/40" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-sm sm:text-base text-ink hover:bg-surface-subtle/50 transition-colors">
            <span class="flex items-start gap-3">
              <span class="font-mono text-xs text-blueprint pt-0.5 tabular-nums">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>{faq.question}</span>
            </span>
            <span
              aria-hidden="true"
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-hairline bg-canvas text-ink-muted group-open:rotate-180 group-open:bg-graphite-900 group-open:text-lime-500 group-open:border-graphite-900 transition-transform duration-150"
            >
              <Icon name="chevron-down" size={15} />
            </span>
          </summary>
          <div class="faq-body px-5 pb-5 pl-12 text-ink-body leading-relaxed text-sm">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </section>
)}
