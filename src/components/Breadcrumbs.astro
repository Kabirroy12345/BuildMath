---
import Icon from './Icon.astro';
import { buildBreadcrumbSchema, type BreadcrumbItem } from '../lib/seo/schema';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const allItems: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  ...items,
];
const schema = buildBreadcrumbSchema(allItems);
---

<nav aria-label="Breadcrumb" class="mb-5 text-xs font-mono text-ink-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    {allItems.map((item, idx) => {
      const isLast = idx === allItems.length - 1;
      return (
        <li class="inline-flex items-center gap-1.5">
          {idx > 0 && (
            <Icon name="chevron-right" size={13} class="text-hairline-strong opacity-80" />
          )}
          {isLast ? (
            <span aria-current="page" class="font-semibold text-ink">
              {item.name}
            </span>
          ) : (
            <a
              href={item.href}
              class="hover:text-blueprint transition-colors underline-offset-4 hover:underline"
            >
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
