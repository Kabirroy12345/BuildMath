---
import { buildBreadcrumbSchema, type BreadcrumbItem } from '../lib/seo/schema';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const allItems: BreadcrumbItem[] = [
  { name: 'Home', href: '/' },
  ...items,
];
const schema = buildBreadcrumbSchema(allItems);
---

<nav aria-label="Breadcrumb" class="mb-4 text-sm text-slate-600 dark:text-slate-400">
  <ol class="flex flex-wrap items-center gap-1.5">
    {allItems.map((item, idx) => {
      const isLast = idx === allItems.length - 1;
      return (
        <li class="flex items-center gap-1.5">
          {idx > 0 && <span aria-hidden="true" class="text-slate-400 dark:text-slate-600">›</span>}
          {isLast ? (
            <span aria-current="page" class="font-medium text-slate-900 dark:text-slate-200">
              {item.name}
            </span>
          ) : (
            <a
              href={item.href}
              class="hover:text-brand-600 dark:hover:text-brand-400 underline-offset-2 hover:underline transition-colors"
            >
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
